{
  "name": "@doraemon-ui/style",
  "private": false,
  "version": "0.0.2-alpha.46",
  "description": "common style component for doraemon-ui",
  "author": "skyvow",
  "homepage": "",
  "license": "MIT",
  "miniprogram": "miniprogram_dist",
  "main": "miniprogram_dist/index.wxss",
  "files": [
    "miniprogram_dist"
  ],
  "keywords": [
    "doraemon-ui",
    "miniprogram",
    "style"
  ],
  "scripts": {
    "build": "pnpm build:color && pnpm build:lib",
    "build:color": "cross-env NODE_ENV=production tsx build-color.ts",
    "build:lib": "lessc lib/runtime.less miniprogram_dist/index.wxss && cp miniprogram_dist/index.wxss miniprogram_dist/index.ttss",
    "test": "cross-env NODE_ENV=testing jest --coverage",
    "clean": "cross-env rimraf miniprogram_dist/* .coverage-report/*",
    "preversion": "pnpm clean && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/less": "^3.0.8",
    "@types/node": "^25.5.2",
    "cross-env": "^7.0.3",
    "jest": "^30.3.0",
    "less": "^4.6.4",
    "rimraf": "^3.0.2",
    "tsx": "^4.21.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
