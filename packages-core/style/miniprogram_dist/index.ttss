  --dora-color-stable-contrast: #fff;
  --dora-color-stable-contrast-rgb: 255, 255, 255;
  --dora-color-stable-shade: #57585c;
  --dora-color-stable-tint: #b7b8ba;
  --dora-color-stable-lighter: #ececed;
  --dora-color-positive: #0054e9;
  --dora-color-positive-rgb: 0, 84, 233;
  --dora-color-positive-contrast: #fff;
  --dora-color-positive-contrast-rgb: 255, 255, 255;
  --dora-color-positive-shade: #004acd;
  --dora-color-positive-tint: #8ab0f5;
  --dora-color-positive-lighter: #e0eafc;
  --dora-color-calm: #0163aa;
  --dora-color-calm-rgb: 1, 99, 170;
  --dora-color-calm-contrast: #fff;
  --dora-color-calm-contrast-rgb: 255, 255, 255;
  --dora-color-calm-shade: #015796;
  --dora-color-calm-tint: #8ab7d8;
  --dora-color-calm-lighter: #e1ecf5;
  --dora-color-balanced: #2dd55b;
  --dora-color-balanced-rgb: 45, 213, 91;
  --dora-color-balanced-contrast: #000;
  --dora-color-balanced-contrast-rgb: 0, 0, 0;
  --dora-color-balanced-shade: #28bb50;
  --dora-color-balanced-tint: #9eecb4;
  --dora-color-balanced-lighter: #e6faeb;
  --dora-color-energized: #ffc409;
  --dora-color-energized-rgb: 255, 196, 9;
  --dora-color-energized-contrast: #000;
  --dora-color-energized-contrast-rgb: 0, 0, 0;
  --dora-color-energized-shade: #e0ac08;
  --dora-color-energized-tint: #ffe48e;
  --dora-color-energized-lighter: #fff8e1;
  --dora-color-assertive: #c5000f;
  --dora-color-assertive-rgb: 197, 0, 15;
  --dora-color-assertive-contrast: #fff;
  --dora-color-assertive-contrast-rgb: 255, 255, 255;
  --dora-color-assertive-shade: #ad000d;
  --dora-color-assertive-tint: #e48a91;
  --dora-color-assertive-lighter: #f8e0e2;
  --dora-color-royal: #6030ff;
  --dora-color-royal-rgb: 96, 48, 255;
  --dora-color-royal-contrast: #fff;
  --dora-color-royal-contrast-rgb: 255, 255, 255;
  --dora-color-royal-shade: #542ae0;
  --dora-color-royal-tint: #b6a0ff;
  --dora-color-royal-lighter: #ece6ff;
  --dora-color-dark: #222428;
  --dora-color-dark-rgb: 34, 36, 40;
  --dora-color-dark-contrast: #fff;
  --dora-color-dark-contrast-rgb: 255, 255, 255;
  --dora-color-dark-shade: #1e2023;
  --dora-color-dark-tint: #999a9c;
  --dora-color-dark-lighter: #e4e5e5;
}
@media (prefers-color-scheme: dark) {
