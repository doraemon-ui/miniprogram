  --dora-color-light: var(--dora-color-stable-light, #ececed) !important;
  --dora-color-contrast: var(--dora-color-stable-contrast, #fff) !important;
  --dora-color-contrast-rgb: var(--dora-color-stable-contrast-rgb, 255, 255, 255) !important;
}
.dora-color--positive {
  --dora-color-base: var(--dora-color-positive, #3880ff) !important;
  --dora-color-base-rgb: var(--dora-color-positive-rgb, 56, 128, 255) !important;
  --dora-color-active: var(--dora-color-positive-active, #3171e0) !important;
  --dora-color-tint: var(--dora-color-positive-tint, #a3c5ff) !important;
  --dora-color-light: var(--dora-color-positive-light, #e7f0ff) !important;
  --dora-color-contrast: var(--dora-color-positive-contrast, #fff) !important;
  --dora-color-contrast-rgb: var(--dora-color-positive-contrast-rgb, 255, 255, 255) !important;
}
.dora-color--calm {
