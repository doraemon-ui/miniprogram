page {
  --dora-default-font: -apple-system-font, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --dora-font-family: var(--dora-default-font);
  --dora-safe-area-top: env(safe-area-inset-top);
  --dora-safe-area-top: constant(safe-area-inset-top);
  --dora-safe-area-bottom: env(safe-area-inset-bottom);
  --dora-safe-area-bottom: constant(safe-area-inset-bottom);
  --dora-safe-area-left: env(safe-area-inset-left);
  --dora-safe-area-left: constant(safe-area-inset-left);
  --dora-safe-area-right: env(safe-area-inset-right);
  --dora-safe-area-right: constant(safe-area-inset-right);
}
page {
  font-family: var(--dora-font-family);
  background: var(--dora-background-color);
}
.dora-color--light {
  --dora-color-base: var(--dora-color-light, #f4f5f8) !important;
  --dora-color-base-rgb: var(--dora-color-light-rgb, 244, 245, 248) !important;
  --dora-color-shade: var(--dora-color-light-shade, #d7d8da) !important;
  --dora-color-tint: var(--dora-color-light-tint, #fafafc) !important;
  --dora-color-lighter: var(--dora-color-light-lighter, #fefefe) !important;
  --dora-color-contrast: var(--dora-color-light-contrast, #000) !important;
  --dora-color-contrast-rgb: var(--dora-color-light-contrast-rgb, 0, 0, 0) !important;
}
.dora-color--stable {
  --dora-color-base: var(--dora-color-stable, #636469) !important;
  --dora-color-base-rgb: var(--dora-color-stable-rgb, 99, 100, 105) !important;
  --dora-color-shade: var(--dora-color-stable-shade, #57585c) !important;
  --dora-color-tint: var(--dora-color-stable-tint, #b7b8ba) !important;
  --dora-color-lighter: var(--dora-color-stable-lighter, #ececed) !important;
  --dora-color-contrast: var(--dora-color-stable-contrast, #fff) !important;
  --dora-color-contrast-rgb: var(--dora-color-stable-contrast-rgb, 255, 255, 255) !important;
}
.dora-color--positive {
  --dora-color-base: var(--dora-color-positive, #0054e9) !important;
  --dora-color-base-rgb: var(--dora-color-positive-rgb, 0, 84, 233) !important;
  --dora-color-shade: var(--dora-color-positive-shade, #004acd) !important;
  --dora-color-tint: var(--dora-color-positive-tint, #8ab0f5) !important;
  --dora-color-lighter: var(--dora-color-positive-lighter, #e0eafc) !important;
  --dora-color-contrast: var(--dora-color-positive-contrast, #fff) !important;
  --dora-color-contrast-rgb: var(--dora-color-positive-contrast-rgb, 255, 255, 255) !important;
}
.dora-color--calm {
  --dora-color-base: var(--dora-color-calm, #0163aa) !important;
  --dora-color-base-rgb: var(--dora-color-calm-rgb, 1, 99, 170) !important;
