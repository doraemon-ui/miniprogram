  --dora-color-step-80: #333333;
  --dora-color-step-75: #404040;
  --dora-color-step-70: #4d4d4d;
  --dora-color-step-65: #595959;
  --dora-color-step-60: #666666;
  --dora-color-step-55: #737373;
  --dora-color-step-50: #808080;
  --dora-color-step-45: #8c8c8c;
  --dora-color-step-40: #999999;
  --dora-color-step-35: #a6a6a6;
  --dora-color-step-30: #b3b3b3;
  --dora-color-step-25: #bfbfbf;
  --dora-color-step-20: #cccccc;
  --dora-color-step-15: #d9d9d9;
  --dora-color-step-10: #e6e6e6;
  --dora-color-step-5: #f2f2f2;
  --dora-color-light: #f4f5f8;
  --dora-color-light-rgb: 244, 245, 248;
  --dora-color-light-contrast: #000;
  --dora-color-light-contrast-rgb: 0, 0, 0;
  --dora-color-light-shade: #d7d8da;
  --dora-color-light-tint: #fafafc;
  --dora-color-light-lighter: #fefefe;
  --dora-color-stable: #636469;
