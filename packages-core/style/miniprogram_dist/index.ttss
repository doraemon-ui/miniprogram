/*! inject:runtime-style */
page {
  --dora-background-color: #fafafa;
  --dora-background-color-rgb: 250, 250, 250;
  --dora-text-color: #000;
  --dora-text-color-rgb: 0, 0, 0;
  --dora-white: #fff;
  --dora-white-rgb: 255, 255, 255;
  --dora-black: #000;
  --dora-black-rgb: 0, 0, 0;
  --dora-component-background-color: #fff;
  --dora-component-background-color-rgb: 255, 255, 255;
  --dora-active-state-bg: #e6e6e6;
  --dora-active-state-bg-rgb: 230, 230, 230;
  --dora-color-step-95: #0d0d0d;
  --dora-color-step-90: #191919;
  --dora-color-step-85: #262626;
  --dora-color-step-80: #333333;
  --dora-color-step-75: #404040;
  --dora-color-step-70: #4d4d4d;
  --dora-color-step-65: #595959;
  --dora-color-step-60: #666666;
  --dora-color-step-55: #737373;
  --dora-color-step-50: #808080;
  --dora-color-step-45: #8c8c8c;
  --dora-color-step-40: #999999;
  --dora-color-step-35: #a6a6a6;
  --dora-color-step-30: #b3b3b3;
  --dora-color-step-25: #bfbfbf;
  --dora-color-step-20: #cccccc;
  --dora-color-step-15: #d9d9d9;
  --dora-color-step-10: #e6e6e6;
  --dora-color-step-5: #f2f2f2;
  --dora-color-light: #f4f5f8;
  --dora-color-light-rgb: 244, 245, 248;
  --dora-color-light-contrast: #000;
  --dora-color-light-contrast-rgb: 0, 0, 0;
  --dora-color-light-active: #d7d8da;
  --dora-color-light-tint: #fafafc;
  --dora-color-light-light: #fefefe;
  --dora-color-stable: #636469;
  --dora-color-stable-rgb: 99, 100, 105;
  --dora-color-stable-contrast: #fff;
  --dora-color-stable-contrast-rgb: 255, 255, 255;
  --dora-color-stable-active: #57585c;
  --dora-color-stable-tint: #b7b8ba;
  --dora-color-stable-light: #ececed;
  --dora-color-positive: #3880ff;
  --dora-color-positive-rgb: 56, 128, 255;
  --dora-color-positive-contrast: #fff;
  --dora-color-positive-contrast-rgb: 255, 255, 255;
  --dora-color-positive-active: #3171e0;
  --dora-color-positive-tint: #a3c5ff;
  --dora-color-positive-light: #e7f0ff;
  --dora-color-calm: #3dc2ff;
  --dora-color-calm-rgb: 61, 194, 255;
  --dora-color-calm-contrast: #fff;
  --dora-color-calm-contrast-rgb: 255, 255, 255;
  --dora-color-calm-active: #36abe0;
  --dora-color-calm-tint: #a6e3ff;
  --dora-color-calm-light: #e8f8ff;
  --dora-color-balanced: #2dd36f;
  --dora-color-balanced-rgb: 45, 211, 111;
  --dora-color-balanced-contrast: #000;
  --dora-color-balanced-contrast-rgb: 0, 0, 0;
  --dora-color-balanced-active: #28ba62;
  --dora-color-balanced-tint: #9eebbd;
  --dora-color-balanced-light: #e6faee;
  --dora-color-energized: #ffc409;
  --dora-color-energized-rgb: 255, 196, 9;
  --dora-color-energized-contrast: #000;
  --dora-color-energized-contrast-rgb: 0, 0, 0;
  --dora-color-energized-active: #e0ac08;
  --dora-color-energized-tint: #ffe48e;
  --dora-color-energized-light: #fff8e1;
  --dora-color-assertive: #eb445a;
  --dora-color-assertive-rgb: 235, 68, 90;
  --dora-color-assertive-contrast: #fff;
  --dora-color-assertive-contrast-rgb: 255, 255, 255;
  --dora-color-assertive-active: #cf3c4f;
  --dora-color-assertive-tint: #f6a9b3;
  --dora-color-assertive-light: #fde9eb;
  --dora-color-royal: #8a63d2;
  --dora-color-royal-rgb: 138, 99, 210;
  --dora-color-royal-contrast: #fff;
  --dora-color-royal-contrast-rgb: 255, 255, 255;
  --dora-color-royal-active: #7957b9;
  --dora-color-royal-tint: #c9b7ea;
  --dora-color-royal-light: #f1ecfa;
  --dora-color-dark: #222428;
  --dora-color-dark-rgb: 34, 36, 40;
  --dora-color-dark-contrast: #fff;
  --dora-color-dark-contrast-rgb: 255, 255, 255;
  --dora-color-dark-active: #1e2023;
  --dora-color-dark-tint: #999a9c;
  --dora-color-dark-light: #e4e5e5;
}
