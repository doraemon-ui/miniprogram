@import '../../@doraemon-ui/style/index.wxss';
.dora-button {
  color: inherit!important;
  background: transparent!important;
  font-size: inherit;
  font-weight: normal;
  line-height: inherit;
  text-align: inherit;
  text-decoration: none;
  overflow: visible;
  min-height: 0!important;
  width: auto!important;
  -webkit-tap-highlight-color: transparent;
  position: relative;
  display: inline-block;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  min-width: auto;
  min-height: auto;
  border: none;
  border-radius: 0;
  vertical-align: middle;
  text-align: center;
  text-overflow: ellipsis;
  font-size: initial;
  line-height: initial;
  cursor: pointer;
  --opacity: 1;
  --activated-opacity: 1;
  --disabled-opacity: var(--dora-button-disabled-opacity, 0.5);
  --border-width: var(--dora-button-border-width, var(--dora-border-width, 2rpx));
  --border-style: var(--dora-button-border-style, var(--dora-border-style, solid));
  --border-color: var(--dora-button-border-color, #0054e9);
  --text-color: var(--dora-color-positive-contrast, #fff);
  --activated-text-color: var(--dora-color-positive-contrast, #fff);
  --background-color: var(--dora-color-positive, #0054e9);
  --activated-background-color: var(--dora-color-positive-shade, #004acd);
  --border-color: var(--dora-color-positive, #0054e9);
  --activated-border-color: var(--dora-color-positive-shade, #004acd);
  --border-radius: var(--dora-button-border-radius, var(--dora-border-radius, 16rpx));
  --font-size: 32rpx;
  --height: 96rpx;
  --padding-start: 24rpx;
  --padding-end: 24rpx;
  padding-top: unset;
  padding-bottom: unset;
  padding-left: 24rpx;
  padding-left: var(--padding-start);
  padding-right: 24rpx;
  padding-right: var(--padding-end);
  min-width: calc((24rpx*1.5) + (24rpx*1.5) + 32rpx);
  min-width: calc((var(--padding-start)*1.5) + (var(--padding-end)*1.5) + var(--font-size));
  min-height: 96rpx!important;
  min-height: var(--height)!important;
  font-size: 32rpx;
  font-size: var(--font-size);
  line-height: calc(96rpx - 2rpx*2);
  line-height: calc(var(--height) - var(--border-width)*2);
  opacity: 1;
  opacity: var(--opacity);
  border-radius: 16rpx;
  border-radius: var(--border-radius);
  border: 2rpx solid #0054e9;
  border: var(--border-width) var(--border-style) var(--border-color);
  border-color: #0054e9!important;
  border-color: var(--border-color)!important;
  background-color: #0054e9!important;
  background-color: var(--background-color)!important;
  color: #fff!important;
  color: var(--text-color)!important;
}

.dora-button::after {
  display: block;
  position: static;
  top: auto;
  left: auto;
  width: auto;
  height: auto;
  border: none;
  border-radius: 0;
  transform: none;
  transform-origin: 0 0;
}

.dora-button::after {
  content: " ";
  width: 100%;
  height: 100%;
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
  left: -12rpx;
  border: none;
  transform: none;
  transform-origin: 0 0;
  box-sizing: border-box;
  border-radius: 0;
}

.dora-button--clear {
  --activated-opacity: var(--dora-button-clear-activated-opacity, 0.4);
  --text-color: var(--dora-color-positive-shade, #004acd);
  --activated-text-color: var(--dora-color-positive-shade, #004acd);
  --background-color: transparent;
  --activated-background-color: transparent;
  --border-color: transparent;
  --activated-border-color: transparent;
}

.dora-button--outline {
  --text-color: var(--dora-color-positive, #0054e9);
  --activated-text-color: var(--dora-color-positive-contrast, #fff);
  --background-color: transparent;
  --activated-background-color: var(--dora-color-positive, #0054e9);
  --border-color: var(--dora-color-positive, #0054e9);
  --activated-border-color: var(--dora-color-positive, #0054e9);
}

.dora-button--small {
  --border-radius: var(--dora-border-radius-sm, 8rpx);
  --font-size: 24rpx;
  --height: 64rpx;
  --padding-start: 8rpx;
  --padding-end: 8rpx;
}

.dora-button--large {
  --border-radius: var(--dora-border-radius-lg, 24rpx);
  --font-size: 40rpx;
  --height: 112rpx;
  --padding-start: 32rpx;
  --padding-end: 32rpx;
}

.dora-button--strong {
  font-weight: 700!important;
}

.dora-button--block,.dora-button--full {
  --block-margin-top: 18rpx;
  --block-margin-bottom: 18rpx;
  width: 100%!important;
  contain: content!important;
  margin-top: 18rpx;
  margin-top: var(--block-margin-top);
  margin-bottom: 18rpx;
  margin-bottom: var(--block-margin-bottom);
}

.dora-button--block {
  display: block;
  clear: both;
}

.dora-button--block::after {
  clear: both;
}

.dora-button--full {
  display: block;
  margin-right: 0!important;
  margin-left: 0!important;
}

.dora-button--full:not(.dora-button--rounded) {
  border-right-width: 0;
  border-left-width: 0;
  border-radius: 0;
}

.dora-button--rounded {
  --border-radius: var(--height);
}

.dora-button--rectangular {
  --border-radius: 0;
}

.dora-button--disabled {
  cursor: default;
  opacity: 0.5!important;
  opacity: var(--disabled-opacity)!important;
  pointer-events: none;
}

.dora-button--activated {
  opacity: 1!important;
  opacity: var(--activated-opacity)!important;
  border-color: #004acd!important;
  border-color: var(--activated-border-color)!important;
  background-color: #004acd!important;
  background-color: var(--activated-background-color)!important;
  color: #fff!important;
  color: var(--activated-text-color)!important;
}

.dora-button.dora-color {
  --text-color: var(--dora-color-contrast);
  --activated-text-color: var(--dora-color-contrast);
  --background-color: var(--dora-color-base);
  --activated-background-color: var(--dora-color-shade);
  --border-color: var(--dora-color-base);
  --activated-border-color: var(--dora-color-shade);
}

.dora-button:is(.dora-button--clear).dora-color {
  --text-color: var(--dora-color-base);
  --activated-text-color: var(--dora-color-base);
  --background-color: transparent;
  --activated-background-color: transparent;
  --border-color: transparent;
  --activated-border-color: transparent;
}

.dora-button:is(.dora-button--outline).dora-color {
  --text-color: var(--dora-color-base);
  --activated-text-color: var(--dora-color-contrast);
  --background-color: transparent;
  --activated-background-color: var(--dora-color-base);
  --border-color: var(--dora-color-base);
  --activated-border-color: var(--dora-color-base);
}

.dora-button:is(.dora-button--fill).dora-color {
  --text-color: var(--dora-color-base);
  --activated-text-color: var(--dora-color-base);
  --background-color: var(--dora-color-lighter);
  --activated-background-color: var(--dora-color-tint);
  --border-color: var(--dora-color-lighter);
  --activated-border-color: var(--dora-color-tint);
}