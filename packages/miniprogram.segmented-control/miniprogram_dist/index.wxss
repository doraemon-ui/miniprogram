@import '../../@doraemon-ui/style/index.wxss';
.dora-segmented-control {
  display: flex;
  border-radius: 8rpx;
  border-radius: var(--dora-border-radius-sm, 8rpx);
  overflow: hidden;
  min-height: 54rpx;
  min-height: var(--dora-segmented-control-size, 54rpx);
  opacity: 1;
  margin: 0 0 18rpx;
  --text-color: var(--dora-color-positive, #3880ff);
  --border-color: var(--dora-color-positive, #3880ff);
  --activated-background-color: var(--dora-color-positive, #3880ff);
}

.dora-segmented-control--disabled {
  opacity: 0.3;
  opacity: var(--dora-disabled-opacity, 0.3);
}

.dora-segmented-control__item {
  display: flex;
  flex: 1;
  justify-content: center;
  align-items: center;
  border-width: 2rpx;
  border-style: solid;
  border-color: #3880ff;
  border-color: var(--border-color);
  color: #3880ff;
  color: var(--text-color);
  font-size: 28rpx;
  font-size: var(--dora-segmented-control-font-size, 28rpx);
  line-height: 1;
  transition: background 0.3s;
  position: relative;
  width: 100%;
  box-sizing: border-box;
  border-left-width: 0;
}

.dora-segmented-control__item:first-child {
  border-left-width: 2rpx;
  border-radius: 8rpx0 0 8rpx;
  border-radius: var(--dora-border-radius-sm, 8rpx)0 0 var(--dora-border-radius-sm, 8rpx);
}

.dora-segmented-control__item:last-child {
  border-radius: 0 8rpx 8rpx0;
  border-radius: 0 var(--dora-border-radius-sm, 8rpx) var(--dora-border-radius-sm, 8rpx)0;
}

.dora-segmented-control__item--current {
  background: #3880ff;
  background: var(--activated-background-color);
  color: #fff;
  color: var(--dora-white, #fff);
}

.dora-segmented-control.dora-color {
  --text-color: var(--dora-color-base);
  --border-color: var(--dora-color-base);
  --activated-background-color: var(--dora-color-base);
}