@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-segmented-control {
  display: flex;
  border-radius: var(--dora-border-radius-sm, 4px);
  border-radius: var(--dora-border-radius-sm, 4px);
  overflow: hidden;
  min-height: var(--dora-segmented-control-size, 27px);
  min-height: var(--dora-segmented-control-size, 27px);
  opacity: 1;
  margin: 0 0 9px;
  --text-color: var(--dora-color-positive, #3880ff);
  --border-color: var(--dora-color-positive, #3880ff);
  --activated-background-color: var(--dora-color-positive, #3880ff);
}

.dora-segmented-control--disabled {
  opacity: var(--dora-disabled-opacity, 0.3);
  opacity: var(--dora-disabled-opacity, 0.3);
}

.dora-segmented-control__item {
  display: flex;
  flex: 1;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-style: solid;
  border-color: var(--border-color);
  border-color: var(--border-color);
  color: var(--text-color);
  color: var(--text-color);
  font-size: var(--dora-segmented-control-font-size, 14px);
  font-size: var(--dora-segmented-control-font-size, 14px);
  line-height: 1;
  transition: background 0.3s;
  position: relative;
  width: 100%;
  box-sizing: border-box;
  border-left-width: 0;
}

.dora-segmented-control__item:first-child {
  border-left-width: 1px;
  border-radius: var(--dora-border-radius-sm, 4px)0 0 var(--dora-border-radius-sm, 4px);
  border-radius: var(--dora-border-radius-sm, 4px)0 0 var(--dora-border-radius-sm, 4px);
}

.dora-segmented-control__item:last-child {
  border-radius: 0 var(--dora-border-radius-sm, 4px) var(--dora-border-radius-sm, 4px)0;
  border-radius: 0 var(--dora-border-radius-sm, 4px) var(--dora-border-radius-sm, 4px)0;
}

.dora-segmented-control__item--current {
  background: var(--activated-background-color);
  background: var(--activated-background-color);
  color: var(--dora-white, #fff);
  color: var(--dora-white, #fff);
}

.dora-segmented-control.dora-color {
  --text-color: var(--dora-color-base);
  --border-color: var(--dora-color-base);
  --activated-background-color: var(--dora-color-base);
}