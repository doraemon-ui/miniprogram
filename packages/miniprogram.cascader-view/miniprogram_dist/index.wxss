@import '../../@doraemon-ui/style/index.wxss';
.dora-cascader-view {
  position: relative;
  font-size: 28rpx;
  font-size: var(--dora-cascader-view-font-size, 28rpx);
  line-height: 1.5;
  color: rgba(0,0,0,0.65);
  color: var(--dora-cascader-view-color, rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.65));
  background-color: #fff;
  background-color: var(--dora-cascader-view-inner-bg, var(--dora-component-background-color, #fff));
  overflow: hidden;
}

.dora-cascader-view__hd {
  position: relative;
  width: 100%;
}

.dora-cascader-view__hd::after {
  content: " ";
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  height: 2rpx;
  border-bottom: 2rpx solid #d9d9d9;
  border-bottom: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 100%;
  transform: scaleY(0.5);
}

.dora-cascader-view__bd {
  width: 100%;
  display: flex;
  background-color: #e6e6e6;
  background-color: var(--dora-cascader-view-bg, var(--dora-color-step-10, #e6e6e6));
}

.dora-cascader-view__inner-scroll {
  display: block;
  height: inherit;
  width: 50%;
  flex: 0 0 50%;
  background-color: #fff;
  background-color: var(--dora-cascader-view-inner-bg, var(--dora-component-background-color, #fff));
}

.dora-cascader-view__inner-scroll--full {
  width: 100%;
  flex: 0 0 100%;
  background-color: #fff!important;
  background-color: var(--dora-cascader-view-inner-bg, var(--dora-component-background-color, #fff))!important;
}

.dora-cascader-view__inner-scroll:nth-child(2n) {
  background-color: #e6e6e6;
  background-color: var(--dora-cascader-view-bg, var(--dora-color-step-10, #e6e6e6));
}

.dora-cascader-view__scroll-view {
  max-height: 540rpx;
  max-height: var(--dora-cascader-view-scroll-view-size, 540rpx);
}