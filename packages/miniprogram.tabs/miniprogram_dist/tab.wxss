@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-tabs__tab {
  flex: 1;
  display: flex;
  width: 100%;
  justify-content: center;
  align-items: center;
  text-align: center;
  position: relative;
  box-sizing: border-box;
  font-size: var(--dora-tabs-font-size, 14px);
  font-size: var(--dora-tabs-font-size, 14px);
  padding: 0 var(--dora-tabs-scrolling-size, 15px);
  padding: 0 var(--dora-tabs-scrolling-size, 15px);
  cursor: pointer;
  --activated-text-color: var(--dora-color-positive, #3880ff);
  --background-color: var(--dora-color-positive, #3880ff);
}

.dora-tabs__tab-bar {
  display: block;
  width: calc(100% - var(--dora-tabs-scrolling-size, 15px)*2);
  width: calc(100% - var(--dora-tabs-scrolling-size, 15px)*2);
  height: var(--dora-tabs-bar-size, 2px);
  height: var(--dora-tabs-bar-size, 2px);
  background: transparent;
  position: absolute;
  bottom: 0;
  left: var(--dora-tabs-scrolling-size, 15px);
  left: var(--dora-tabs-scrolling-size, 15px);
  background: var(--background-color);
  background: var(--background-color);
  border-radius: var(--dora-tabs-bar-size, 2px);
  border-radius: var(--dora-tabs-bar-size, 2px);
}

.dora-tabs__tab-bar--full {
  width: 100%;
  left: 0;
}

.dora-tabs__tab--vertical {
  padding: 0 var(--dora-tabs-scrolling-size, 15px);
  padding: 0 var(--dora-tabs-scrolling-size, 15px);
}

.dora-tabs__tab--vertical .dora-tabs__tab-bar {
  width: var(--dora-tabs-bar-size, 2px);
  width: var(--dora-tabs-bar-size, 2px);
  height: 100%;
  right: 0;
  left: auto;
}

.dora-tabs__tab--current {
  color: var(--activated-text-color);
  color: var(--activated-text-color);
}

.dora-tabs__tab--horizontal.dora-tabs__tab--scroll {
  display: inline-flex;
  width: auto;
}

.dora-tabs__tab--disabled {
  opacity: var(--dora-disabled-opacity, 0.3);
  opacity: var(--dora-disabled-opacity, 0.3);
  cursor: not-allowed;
}

.dora-tabs__tab.dora-color {
  --activated-text-color: var(--dora-color-base);
  --background-color: var(--dora-color-base);
}