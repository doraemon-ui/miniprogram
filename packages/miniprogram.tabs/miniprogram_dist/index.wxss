@import '../../@doraemon-ui/style/index.wxss';
.dora-tabs {
  position: relative;
}

.dora-tabs--scroll .dora-tabs__scroll-view {
  display: block;
  overflow: auto;
  white-space: nowrap;
}

.dora-tabs--vertical {
  display: inline-flex;
}

.dora-tabs--vertical .dora-tabs__scroll-view {
  display: inline-flex;
  width: auto;
  height: auto;
  max-height: 540rpx;
  max-height: var(--dora-tabs-vertical-height, 540rpx);
  flex-direction: column;
}

.dora-tabs__scroll-view {
  display: flex;
  width: 100%;
  height: 88rpx;
  height: var(--dora-tabs-height, 88rpx);
  line-height: 88rpx;
  line-height: var(--dora-tabs-height, 88rpx);
  box-sizing: border-box;
  position: relative;
  justify-content: space-around;
  align-items: center;
  background: #fff;
  background: var(--dora-tabs-background-color, var(--dora-component-background-color, #fff));
}

.dora-tabs__mask {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 40rpx;
  height: 100%;
  pointer-events: none;
}

.dora-tabs__mask--prev {
  left: 0;
  background: linear-gradient(90deg,#fff,hsla(0,0%,100%,0));
}

.dora-tabs__mask--next {
  right: 0;
  background: linear-gradient(270deg,#fff,hsla(0,0%,100%,0));
}

.dora-tabs--vertical .dora-tabs__mask {
  width: 100%;
  height: 40rpx;
  left: 0;
  right: unset;
}

.dora-tabs--vertical .dora-tabs__mask--prev {
  bottom: unset;
  background: linear-gradient(180deg,#fff,hsla(0,0%,100%,0));
}

.dora-tabs--vertical .dora-tabs__mask--next {
  top: unset;
  background: linear-gradient(0deg,#fff,hsla(0,0%,100%,0));
}

.dora-tabs__tab {
  flex: 1;
  display: flex;
  width: 100%;
  justify-content: center;
  align-items: center;
  text-align: center;
  position: relative;
  box-sizing: border-box;
  font-size: 28rpx;
  font-size: var(--dora-tabs-font-size, 28rpx);
  padding: 0 30rpx;
  padding: 0 var(--dora-tabs-scrolling-size, 30rpx);
  cursor: pointer;
  --activated-text-color: var(--dora-color-positive, #3880ff);
  --background-color: var(--dora-color-positive, #3880ff);
}

.dora-tabs__tab-bar {
  display: block;
  width: calc(100% - 30rpx*2);
  width: calc(100% - var(--dora-tabs-scrolling-size, 30rpx)*2);
  height: 4rpx;
  height: var(--dora-tabs-bar-size, 4rpx);
  background: transparent;
  position: absolute;
  bottom: 0;
  left: 30rpx;
  left: var(--dora-tabs-scrolling-size, 30rpx);
  background: var(--background-color);
  border-radius: 4rpx;
  border-radius: var(--dora-tabs-bar-size, 4rpx);
}

.dora-tabs__tab-bar--full {
  width: 100%;
  left: 0;
}

.dora-tabs__tab--vertical {
  padding: 0 30rpx;
  padding: 0 var(--dora-tabs-scrolling-size, 30rpx);
}

.dora-tabs__tab--vertical .dora-tabs__tab-bar {
  width: 4rpx;
  width: var(--dora-tabs-bar-size, 4rpx);
  height: 100%;
  right: 0;
  left: auto;
}

.dora-tabs__tab--current {
  color: var(--activated-text-color);
}

.dora-tabs__tab--horizontal.dora-tabs__tab--scroll {
  display: inline-flex;
  width: auto;
}

.dora-tabs__tab--disabled {
  opacity: 0.3;
  opacity: var(--dora-disabled-opacity, 0.3);
  cursor: not-allowed;
}

.dora-tabs__tab.dora-color {
  --activated-text-color: var(--dora-color-base);
  --background-color: var(--dora-color-base);
}