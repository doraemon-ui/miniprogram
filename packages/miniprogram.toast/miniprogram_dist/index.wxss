@import '../../@doraemon-ui/style/index.wxss';
.dora-toast {
  --text-color: var(--dora-toast-text-color, #fff);
  --background-color: var(--dora-toast-background-color, rgba(0, 0, 0, 0.7));
  --border-radius: var(--dora-toast-border-radius, var(--dora-border-radius, 16rpx));
  --min-width: var(--dora-toast-min-width, 192rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0,0,0,0.7);
  background-color: var(--background-color);
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  min-width: 192rpx;
  min-width: var(--min-width);
  width: -moz-fit-content;
  width: fit-content;
  border-radius: 16rpx;
  border-radius: var(--border-radius);
  color: #fff;
  color: var(--text-color);
}

.dora-toast__content {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.dora-toast__content--has-icon {
  padding-top: 32rpx;
  padding-bottom: 32rpx;
  padding-left: 64rpx;
  padding-right: 64rpx;
}

.dora-toast__content--has-icon .dora-toast__text {
  margin-top: 18rpx;
  margin-bottom: unset;
}

.dora-toast__icon {
  margin: 0;
  display: inline-block;
}

.dora-toast__icon--loading {
  animation: loadingCircle 1s infinite linear;
}

.dora-toast__img {
  width: 96rpx;
  height: auto;
}

@keyframes loadingCircle {
  to {
    transform: rotate(360deg);
  }
}