<demo-page darkmode="auto" title="Icon" desc="图标" clickable>
  <demo-block>
    <input placeholder="在此搜索 {{ iconSize }} 个图标，点击图标可复制代码" bindinput="onSearchInput" />
  </demo-block>
  <block wx:for="{{ icons }}" wx:key="index">
    <demo-block title="{{ item.fontFamily }}">
      <view class="grid">
        <block wx:for="{{ item.icons }}" wx:for-item="icon" wx:key="index">
          <view class="grid__item" bindtap="onIconClick" data-font="{{ item.fontFamily }}" data-icon="{{ icon }}">
            <dora-icon prefixCls="{{ item.fontFamily }}" type="{{ icon }}" />
            <view class="grid__label">{{ icon }}</view>
          </view>
        </block>
      </view>
    </demo-block>
  </block>
</demo-page>