<block wx:if="{{ layout !== 'none' }}">
  <dora-list
    dora-class="{{ classes.wrap }}"
    prefixCls="{{ cellGroupPrefixCls }}"
    title="{{ title }}"
    label="{{ label }}"
    mode="{{ mode }}"
    bodyStyle="{{ { overflow: 'visible', ...bodyStyle } }}"
  >
    <slot></slot>
  </dora-list>
  <view class="{{ classes.footer }}">
    <slot name="footer"></slot>
  </view>
</block>
<block wx:else>
  <slot></slot>
</block>
