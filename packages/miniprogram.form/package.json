{
  "name": "@doraemon-ui/miniprogram.form",
  "private": false,
  "version": "0.0.1-alpha.1",
  "description": "miniprogram form component for doraemon-ui",
  "author": "skyvow",
  "homepage": "",
  "license": "MIT",
  "miniprogram": "miniprogram_dist",
  "main": "miniprogram_dist/index.js",
  "module": "miniprogram_dist/index.js",
  "devMain": "src/index.ts",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "miniprogram_dist"
  ],
  "keywords": [
    "doraemon-ui",
    "miniprogram",
    "form"
  ],
  "scripts": {
    "serve": "dora serve ./playground --open --build-npm",
    "build:dev": "dora build --watch",
    "build": "dora build && pnpm build:dts",
    "build:dts": "cross-env NODE_ENV=production tsx build-dts.ts",
    "test": "cross-env NODE_ENV=testing jest --coverage",
    "clean": "cross-env rimraf miniprogram_dist/* .coverage-report/*",
    "preversion": "pnpm clean && pnpm build && pnpm test"
  },
  "dependencies": {
    "@doraemon-ui/miniprogram.checkbox": "workspace:*",
    "@doraemon-ui/miniprogram.core-js": "workspace:*",
    "@doraemon-ui/miniprogram.date-picker": "workspace:*",
    "@doraemon-ui/miniprogram.icon": "workspace:*",
    "@doraemon-ui/miniprogram.input": "workspace:*",
    "@doraemon-ui/miniprogram.input-number": "workspace:*",
    "@doraemon-ui/miniprogram.list": "workspace:*",
    "@doraemon-ui/miniprogram.popover": "workspace:*",
    "@doraemon-ui/miniprogram.popup-select": "workspace:*",
    "@doraemon-ui/miniprogram.picker": "workspace:*",
    "@doraemon-ui/miniprogram.radio": "workspace:*",
    "@doraemon-ui/miniprogram.rater": "workspace:*",
    "@doraemon-ui/miniprogram.selectable": "workspace:*",
    "@doraemon-ui/miniprogram.selector-group": "workspace:*",
    "@doraemon-ui/miniprogram.slider": "workspace:*",
    "@doraemon-ui/miniprogram.switch": "workspace:*",
    "@doraemon-ui/miniprogram.textarea": "workspace:*",
    "@doraemon-ui/style": "workspace:*"
  },
  "devDependencies": {
    "@doraemon-ui/miniprogram.cli": "0.0.2-alpha.65",
    "@doraemon-ui/miniprogram.tools": "0.0.2-alpha.65",
    "@types/node": "^25.5.2",
    "cross-env": "^7.0.3",
    "jest": "^30.3.0",
    "rimraf": "^3.0.2",
    "tsx": "^4.21.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
