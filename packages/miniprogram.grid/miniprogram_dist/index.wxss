@import '../../@doraemon-ui/style/index.wxss';
.dora-grid {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #fff;
  background-color: var(--dora-component-background-color, #fff);
}

.dora-grid--bordered::before {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 2rpx;
  border-top: 2rpx solid #d9d9d9;
  border-top: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 0;
  transform: scaleY(0.5);
}

.dora-grid--bordered::after {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  width: 2rpx;
  bottom: 0;
  border-left: 2rpx solid #d9d9d9;
  border-left: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 0;
  transform: scaleX(0.5);
}