@import '../../@doraemon-ui/style/index.wxss';
.dora-checkbox__selectable {
  position: static!important;
}

.dora-checkbox__icon-position {
  display: flex;
  align-items: center;
}

.dora-checkbox__icon-selectable {
  min-width: 70rpx;
  margin-right: calc((24rpx + 2rpx)/2);
}

.dora-checkbox__extra {
  align-self: center;
  text-align: left;
  color: rgba(0,0,0,0.45);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.45);
  margin-right: 12rpx;
}