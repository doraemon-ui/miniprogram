@import '../../@doraemon-ui/style/index.wxss';
.dora-navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  height: var(--dora-navbar-size, 88rpx);
  background-color: #f4f5f8;
  background-color: var(--background-color);
  color: rgba(0,0,0,0.85);
  color: var(--text-color);
  --text-color: rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.85);
  --background-color: var(--dora-color-light, #f4f5f8);
}

.dora-navbar__left,.dora-navbar__title,.dora-navbar__right {
  display: flex;
  align-items: center;
  flex: 1;
  height: 100%;
}

.dora-navbar__left {
  padding-left: 24rpx;
  padding-left: var(--dora-navbar-margin, 24rpx);
  font-size: 28rpx;
  font-size: var(--dora-navbar-font-size, 28rpx);
}

.dora-navbar__title {
  justify-content: center;
  font-size: calc(28rpx + 4rpx);
  font-size: calc(var(--dora-navbar-font-size, 28rpx) + 4rpx);
  white-space: nowrap;
}

.dora-navbar__right {
  justify-content: flex-end;
  font-size: 28rpx;
  font-size: var(--dora-navbar-font-size, 28rpx);
  margin-right: 24rpx;
  margin-right: var(--dora-navbar-margin, 24rpx);
}

.dora-navbar.dora-color {
  --text-color: var(--dora-white, #fff);
  --background-color: var(--dora-color-base);
}

.dora-navbar.dora-color.dora-color--light {
  --text-color: rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.85);
  --background-color: var(--dora-color-base);
}

.dora-navbar.dora-color.dora-color--stable {
  --text-color: rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.85);
  --background-color: var(--dora-color-base);
}