@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-navbar {
  display: flex;
  align-items: center;
  height: var(--dora-navbar-size, 44px);
  height: var(--dora-navbar-size, 44px);
  background-color: var(--background-color);
  background-color: var(--background-color);
  color: var(--text-color);
  color: var(--text-color);
  --text-color: rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.65);
  --background-color: var(--dora-color-light, #f4f5f8);
}

.dora-navbar__left,.dora-navbar__title,.dora-navbar__right {
  display: flex;
  align-items: center;
  flex: 1;
  height: 100%;
}

.dora-navbar__left {
  padding-left: var(--dora-navbar-margin, 12px);
  padding-left: var(--dora-navbar-margin, 12px);
  font-size: var(--dora-navbar-font-size, 14px);
  font-size: var(--dora-navbar-font-size, 14px);
}

.dora-navbar__title {
  justify-content: center;
  font-size: calc(var(--dora-navbar-font-size, 14px) + 4rpx);
  font-size: calc(var(--dora-navbar-font-size, 14px) + 4rpx);
  white-space: nowrap;
}

.dora-navbar__right {
  justify-content: flex-end;
  font-size: var(--dora-navbar-font-size, 14px);
  font-size: var(--dora-navbar-font-size, 14px);
  margin-right: var(--dora-navbar-margin, 12px);
  margin-right: var(--dora-navbar-margin, 12px);
}

.dora-navbar.dora-color {
  --text-color: var(--dora-white, #fff);
  --background-color: var(--dora-color-base);
}

.dora-navbar.dora-color.dora-color--light {
  --text-color: rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.65);
  --background-color: var(--dora-color-base);
}

.dora-navbar.dora-color.dora-color--stable {
  --text-color: rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.65);
  --background-color: var(--dora-color-base);
}