@import '../../@doraemon-ui/style/index.wxss';
.dora-tag {
  --default-solid-text-color: #fff;
  --default-background-color: #f5f5f5;
  --default-text-color: rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.65);
  display: inline-flex;
  align-items: center;
  line-height: 40rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  border-radius: var(--dora-border-radius-sm, 8rpx);
  border-width: 2rpx;
  border-style: solid;
  border-color: var(--border-color);
  font-size: 28rpx;
  white-space: nowrap;
  box-sizing: border-box;
  color: rgba(0,0,0,0.65);
  color: var(--default-text-color);
  background-color: #f5f5f5;
  background-color: var(--default-background-color);
}

.dora-tag--hover {
  opacity: 0.85;
}

.dora-tag__icon {
  margin-left: 8rpx;
}

.dora-tag.dora-color {
  color: #fff;
  color: var(--text-color);
  background-color: var(--dora-color-base);
  background-color: var(--background-color);
  border-color: var(--dora-color-base);
  border-color: var(--border-color);
  --text-color: #fff;
  --background-color: var(--dora-color-base);
  --border-color: var(--dora-color-base);
}

.dora-tag:is(.dora-tag--fill).dora-color {
  --text-color: var(--dora-color-base);
  --background-color: var(--dora-color-lighter);
  --border-color: transparent;
}

.dora-tag:is(.dora-tag--solid).dora-color {
  --text-color: #fff;
  --background-color: var(--dora-color-base);
  --border-color: var(--dora-color-base);
}

.dora-tag:is(.dora-tag--outline).dora-color {
  --text-color: var(--dora-color-shade);
  --background-color: var(--dora-color-tint);
  --border-color: var(--dora-color-base);
}

.dora-tag:is(.dora-tag--fill) {
  --background-color: var(--default-background-color);
  --border-color: transparent;
}

.dora-tag:is(.dora-tag--solid) {
  --border-color: transparent;
  --background-color: var(--default-background-color);
  --text-color: var(--default-solid-text-color);
}