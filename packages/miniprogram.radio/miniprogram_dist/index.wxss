@import '../../@doraemon-ui/style/index.wxss';
.dora-radio__selectable {
  position: static!important;
}

.dora-radio__icon-position {
  display: flex;
  align-items: center;
}

.dora-radio__icon-selectable {
  min-width: 56rpx;
  margin-right: 24rpx;
}

.dora-radio__thumb {
  width: 40rpx;
  width: var(--dora-radio-thumb-size, 40rpx);
  height: 40rpx;
  height: var(--dora-radio-thumb-size, 40rpx);
  display: block;
  margin-right: 12rpx;
}