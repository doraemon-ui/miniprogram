@import '../../@doraemon-ui/style/index.wxss';
.dora-popup-select {
  background: #fff;
}

.dora-popup-select__toolbar {
  border-bottom: 2rpx solid #d9d9d9;
  border-bottom: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
}

.dora-popup-select__toolbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.dora-popup-select__cancel,.dora-popup-select__confirm {
  color: #2dd36f;
  color: var(--dora-color-balanced, #2dd36f);
  font-size: 28rpx;
}

.dora-popup-select__title {
  color: rgba(0,0,0,0.65);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.65);
  font-size: 30rpx;
  font-weight: 500;
}

.dora-popup-select__hover {
  opacity: 0.75;
}

.dora-popup-select__list {
  max-height: 480rpx;
}

.dora-popup-select__group {
  padding: 16rpx 24rpx;
  color: rgba(0,0,0,0.45);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.45);
  font-size: 24rpx;
  background: #fafafa;
}

.dora-popup-select__option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 2rpx solid #d9d9d9;
  border-bottom: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  font-size: 28rpx;
}

.dora-popup-select__option--disabled {
  color: #c7c7cc;
}

.dora-popup-select__option--selected {
  color: #2dd36f;
  color: var(--dora-color-balanced, #2dd36f);
  font-weight: 500;
}

.dora-popup-select__prompt {
  position: relative;
  min-height: 480rpx/2;
  padding: 48rpx 24rpx;
  box-sizing: border-box;
}