@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-avatar {
  box-sizing: border-box;
  display: inline-block;
  text-align: center;
  background: var(--dora-color-step-20, #cccccc);
  background: var(--dora-color-step-20, #cccccc);
  color: var(--dora-white, #fff);
  color: var(--dora-white, #fff);
  white-space: nowrap;
  position: relative;
  overflow: hidden;
  vertical-align: middle;
  width: 32px;
  height: 32px;
  line-height: 32px;
  border-radius: calc(32px/2);
  font-size: 18px;
}

.dora-avatar .dora-avatar__string {
  line-height: 32px;
}

.dora-avatar--small {
  width: 24px;
  height: 24px;
  line-height: 24px;
  border-radius: calc(24px/2);
  font-size: 14px;
}

.dora-avatar--small .dora-avatar__string {
  line-height: 24px;
}

.dora-avatar--large {
  width: 40px;
  height: 40px;
  line-height: 40px;
  border-radius: calc(40px/2);
  font-size: 24px;
}

.dora-avatar--large .dora-avatar__string {
  line-height: 40px;
}

.dora-avatar--square {
  border-radius: var(--dora-border-radius, 8px);
  border-radius: var(--dora-border-radius, 8px);
}

.dora-avatar--thumb {
  background: transparent;
}

.dora-avatar__image {
  width: 100%;
  height: 100%;
}