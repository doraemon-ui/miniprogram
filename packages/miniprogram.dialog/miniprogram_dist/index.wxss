@import '../../@doraemon-ui/style/index.wxss';
.dora-dialog {
  --font-size: var(--dora-dialog-font-size, 34rpx);
  --title-font-size: var(--dora-dialog-title-font-size, 36rpx);
  --button-text-color: var(--dora-color-dark, #222428);
  position: relative;
  background-color: #fff;
  background-color: var(--dora-component-background-color, #fff);
  border: 0;
  background-clip: padding-box;
  height: 100%;
  text-align: center;
  overflow: hidden;
  border-radius: 24rpx;
  border-radius: var(--dora-border-radius-lg, 24rpx);
}

.dora-dialog__title {
  font-weight: 700;
  font-size: 36rpx;
  font-size: var(--title-font-size);
  color: #000;
  color: var(--dora-black, #000);
  margin-bottom: 24rpx;
}

.dora-dialog__title:last-child {
  margin-bottom: 0;
}

.dora-dialog__bd {
  font-size: 34rpx;
  font-size: var(--font-size);
  line-height: 1.4;
  word-wrap: break-word;
  word-break: break-all;
  color: rgba(0,0,0,0.45);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.45);
  padding: 48rpx 24rpx;
}

.dora-dialog__ft {
  position: relative;
  line-height: 112rpx;
  font-size: 36rpx;
  font-size: var(--title-font-size);
  display: flex;
}

.dora-dialog__ft::after {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 2rpx;
  border-top: 2rpx solid #d9d9d9;
  border-top: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 0;
  transform: scaleY(0.5);
}

.dora-dialog__image {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.dora-dialog__image-img {
  width: 100%;
  height: 100%;
  -o-object-fit: fill;
  object-fit: fill;
  display: block;
}

.dora-dialog__buttons {
  display: flex;
  flex: 1;
}

.dora-dialog__buttons--horizontal .dora-dialog__button::after {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  width: 2rpx;
  bottom: 0;
  border-left: 2rpx solid #d9d9d9;
  border-left: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 0;
  transform: scaleX(0.5);
}

.dora-dialog__buttons--horizontal .dora-dialog__button:first-child::after {
  display: none;
}

.dora-dialog__buttons--vertical {
  display: block;
  height: auto;
}

.dora-dialog__buttons--vertical .dora-dialog__button::after {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 2rpx;
  border-top: 2rpx solid #d9d9d9;
  border-top: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 0;
  transform: scaleY(0.5);
}

.dora-dialog__button {
  padding: 0;
  margin: 0;
  border-radius: 0;
  color: inherit!important;
  background: transparent!important;
  font-size: inherit;
  font-weight: normal;
  line-height: inherit;
  text-align: inherit;
  text-decoration: none;
  overflow: visible;
  min-height: 0!important;
  width: auto!important;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
  display: block;
  flex: 1;
  color: #222428!important;
  color: var(--button-text-color)!important;
  position: relative;
}

.dora-dialog__button::after {
  display: block;
  position: static;
  top: auto;
  left: auto;
  width: auto;
  height: auto;
  border: none;
  border-radius: 0;
  transform: none;
  transform-origin: 0 0;
}

.dora-dialog__button.dora-color {
  --button-text-color: var(--dora-color-base);
}

.dora-dialog__button--bold {
  font-weight: 700!important;
}

.dora-dialog__button--hover {
  background-color: #e6e6e6!important;
  background-color: var(--dora-active-state-bg, var(--dora-color-step-10, #e6e6e6))!important;
}

.dora-dialog__button--disabled {
  opacity: 0.3;
  opacity: var(--dora-disabled-opacity, 0.3);
}