@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-timeline {
  position: relative;
}

.dora-timeline-item {
  position: relative;
  padding: 0 0 12px;
  margin: 0;
  font-size: 14px;
  box-sizing: border-box;
}

.dora-timeline-item__tail {
  height: 100%;
  border-left: 1px solid var(--dora-border-color, var(--dora-color-step-10, #e6e6e6));
  border-left: 1px solid var(--dora-border-color, var(--dora-color-step-10, #e6e6e6));
  position: absolute;
  left: 5px;
  top: 0;
  box-sizing: border-box;
}

.dora-timeline-item__dot {
  width: 6px;
  height: 6px;
  background-color: #fff;
  border-radius: 50%;
  border: 1px solid #387ef5;
  position: absolute;
  color: #387ef5;
  box-sizing: border-box;
}

.dora-timeline-item__dot--custom {
  margin-left: 1px!important;
  left: 5px;
  top: 8px;
  border: 0;
  border-radius: 0;
  width: auto;
  height: auto;
  background-color: transparent;
  text-align: center;
  transform: translate(-50%,-50%);
}

.dora-timeline-item__content {
  padding: 0 0 10px 20px;
  position: relative;
  top: -5px;
  width: 100%;
  box-sizing: border-box;
}

.dora-timeline-item--last .dora-timeline-item__tail,.dora-timeline-item--pending .dora-timeline-item__tail--pending {
  display: none;
}

.dora-timeline-item--last.dora-timeline-item--pending .dora-timeline-item__tail {
  display: block;
  border-left-style: dotted;
}

.dora-timeline-item--right .dora-timeline-item__tail {
  left: 100%;
}

.dora-timeline-item--right .dora-timeline-item__dot {
  left: 100%;
  margin-left: -5px;
}

.dora-timeline-item--right .dora-timeline-item__content {
  text-align: right;
  right: 0;
  left: -20px;
}

.dora-timeline-item--alternate.dora-timeline-item--right .dora-timeline-item__tail,.dora-timeline-item--alternate.dora-timeline-item--left .dora-timeline-item__tail {
  left: 50%;
}

.dora-timeline-item--alternate.dora-timeline-item--right .dora-timeline-item__dot,.dora-timeline-item--alternate.dora-timeline-item--left .dora-timeline-item__dot {
  left: 50%;
  margin-left: -5px;
}

.dora-timeline-item--alternate.dora-timeline-item--right .dora-timeline-item__content {
  text-align: right;
  right: 50%;
  width: 50%;
}

.dora-timeline-item--alternate.dora-timeline-item--left .dora-timeline-item__content {
  text-align: left;
  left: 50%;
  width: 50%;
}