@import '../../@doraemon-ui/style/index.wxss';
.dora-floating-panel {
  --z-index: var(--dora-floating-panel-z-index, 1020);
  position: fixed;
  z-index: 1020;
  z-index: var(--z-index);
  bottom: 0;
  left: 0;
  width: 100vw;
  display: flex;
  flex-direction: column;
  touch-action: none;
}

.dora-floating-panel::after {
  content: "";
  display: block;
  position: absolute;
  bottom: -100vh;
  height: 100vh;
  width: 100vw;
  background: #fff;
  background: var(--dora-component-background-color, #fff);
}

.dora-floating-panel__hd {
  flex: none;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: grab;
  -webkit-user-select: none;
  -moz-user-select: none;
  user-select: none;
  background-color: #fff;
  background-color: var(--dora-component-background-color, #fff);
  border-top-left-radius: calc(64rpx/2);
  border-top-right-radius: calc(64rpx/2);
}

.dora-floating-panel__bar {
  height: 6rpx;
  width: 40rpx;
  border-radius: 20rpx;
  background: #bfbfbf;
  background: var(--dora-color-step-25, #bfbfbf);
}

.dora-floating-panel__bd {
  flex: 1 1;
  overflow-y: scroll;
  background: #fff;
  background: var(--dora-component-background-color, #fff);
}

.dora-floating-panel__mask {
  display: block;
  width: 100%;
  height: 100vh;
  position: absolute;
  left: 0;
  top: -100vh;
  background: transparent;
}