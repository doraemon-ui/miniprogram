@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-gallery {
  --z-index: var(--dora-gallery-z-index, var(--dora-component-z-index, 1000));
  --background-color: var(--dora-gallery-background-color, #000);
  --icon-size: var(--dora-gallery-icon-size, 24px);
  position: fixed;
  inset: 0;
  z-index: var(--z-index);
  z-index: var(--z-index);
  display: block;
  background-color: var(--background-color);
  background-color: var(--background-color);
}

.dora-gallery__swiper {
  width: 100%;
  height: 100%;
}

.dora-gallery__item {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dora-gallery__img {
  flex: none;
  width: 100%;
  height: 100%;
}

.dora-gallery__remark {
  position: absolute;
  right: 0;
  bottom: 60px;
  left: 0;
  z-index: 10;
  padding: 15px;
  font-size: 14px;
  color: #fff;
  text-align: center;
  opacity: 0;
  transition: opacity 0.3s ease 0.5s;
}

.dora-gallery__remark--active {
  opacity: 1;
}

.dora-gallery__opr {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  color: #fff;
  text-align: center;
  background-color: var(--background-color);
  background-color: var(--background-color);
}

.dora-gallery__del {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px 0;
}

.dora-gallery__icon {
  width: var(--icon-size);
  width: var(--icon-size);
  height: var(--icon-size);
  height: var(--icon-size);
}

.dora-gallery__icon:not(.dora-gallery__icon--img) {
  color: #fff;
  background-image: url(data:image/png;base64,);
  background-repeat: no-repeat;
  background-position: center center;
  background-size: contain;
}