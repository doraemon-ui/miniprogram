@import '../../@doraemon-ui/style/index.wxss';
.dora-image {
  --text-color: var(--image-text-color, rgba(var(--dora-text-color-rgb, 0, 0, 0), 0.45));
  --rounded-border-radius: var(--image-rounded-border-radius, var(--dora-border-radius, 16rpx));
  --thumbnail-background-color: var(--image-thumbnail-background-color, var(--dora-component-background-color, #fff));
  --thumbnail-margin: var(--image-thumbnail-margin, 8rpx);
  position: relative;
  overflow: hidden;
  display: flex;
  box-sizing: border-box;
}

.dora-image--rounded {
  border-radius: 16rpx;
  border-radius: var(--rounded-border-radius);
}

.dora-image--circle {
  border-radius: 50%;
}

.dora-image--thumbnail {
  background-color: #fff;
  background-color: var(--thumbnail-background-color);
  border-radius: 8rpx;
  border-radius: var(--thumbnail-margin);
}

.dora-image--thumbnail::after {
  content: " ";
  position: absolute;
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  transform: scale(0.5);
  transform-origin: 0 0;
  pointer-events: none;
  box-sizing: border-box;
  border: 0 solid #d9d9d9;
  border: 0 solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  border-width: 2rpx;
  border-width: var(--dora-border-width, 2rpx);
  border-radius: calc(8rpx*2);
  border-radius: calc(var(--thumbnail-margin)*2);
}

.dora-image--thumbnail .dora-image__inner,.dora-image--thumbnail .dora-image__mask {
  top: 8rpx;
  top: var(--thumbnail-margin);
  right: 8rpx;
  right: var(--thumbnail-margin);
  bottom: 8rpx;
  bottom: var(--thumbnail-margin);
  left: 8rpx;
  left: var(--thumbnail-margin);
  width: calc(100% - 2*8rpx)!important;
  width: calc(100% - 2*var(--thumbnail-margin))!important;
  height: calc(100% - 2*8rpx)!important;
  height: calc(100% - 2*var(--thumbnail-margin))!important;
}

.dora-image--widthFix .dora-image__inner {
  position: relative;
}

.dora-image__inner image,.dora-image__mask image,.dora-image__thumb {
  display: inline-block;
  overflow: hidden;
  width: 100%;
  height: 100%;
  vertical-align: middle;
}

.dora-image__inner {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  width: 100%;
  height: 100%;
  opacity: 0;
}

.dora-image--loaded .dora-image__inner {
  opacity: 1;
}

.dora-image__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
}

.dora-image__mask--text {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dora-image__text {
  color: rgba(0,0,0,0.45);
  color: var(--text-color);
  text-align: center;
  padding: 20rpx;
}