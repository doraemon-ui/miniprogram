@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-input {
  position: relative;
  display: flex;
  align-items: center;
}

.dora-input__label {
  position: relative;
  margin-left: 0;
  margin-right: 6px;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  width: var(--dora-input-label-width, 105px);
  width: var(--dora-input-label-width, 105px);
}

.dora-input__label--wrap {
  white-space: normal;
}

.dora-input__label--required::before {
  display: inline-block;
  margin-right: 3px;
  color: var(--dora-color-assertive, #eb445a);
  color: var(--dora-color-assertive, #eb445a);
  font-size: 14px;
  font-family: SimSun,sans-serif;
  line-height: 1;
  content: "*";
}

.dora-input__control {
  flex: 1;
}

.dora-input__item {
  width: 100%;
  border: 0;
  outline: 0;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  background-color: transparent;
  font-size: inherit;
  color: inherit;
  height: 1.47058824em;
  min-height: 1.47058824em;
  line-height: 1.47058824;
}

.dora-input__clear {
  display: flex;
}

.dora-input__eye {
  display: flex;
  width: var(--dora-input-eye-size, 16px);
  width: var(--dora-input-eye-size, 16px);
  height: var(--dora-input-eye-size, 16px);
  height: var(--dora-input-eye-size, 16px);
  background-repeat: no-repeat;
  background-size: contain;
  margin-left: 6px;
}

.dora-input__error {
  display: flex;
  margin-left: 6px;
}

.dora-input__extra {
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.45);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.45);
  margin-left: 6px;
}

.dora-input--disabled {
  opacity: var(--dora-disabled-opacity, 0.3);
  opacity: var(--dora-disabled-opacity, 0.3);
  cursor: not-allowed;
}

.dora-input--error .dora-input__control {
  color: var(--dora-color-assertive, #eb445a);
  color: var(--dora-color-assertive, #eb445a);
}

.dora-input__keyboardAccessory {
  max-height: 200px;
}