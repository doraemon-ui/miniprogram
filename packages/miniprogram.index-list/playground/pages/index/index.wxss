.demo-item {
  position: relative;
  padding: 20rpx;
}

.demo-item::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 2rpx;
  color: #d9d9d9;
  content: ' ';
  border-bottom: 2rpx solid #d9d9d9;
  transform: scaleY(.5);
  transform-origin: 0 100%;
}

.demo-item:last-child::after {
  display: none;
}

.demo-btn {
  position: absolute !important;
  bottom: 176rpx;
  left: 50%;
  width: 80%;
  transform: translateX(-50%);
}
