@import '../../@doraemon-ui/style/index.wxss';
.dora-index-list-item {
  --item-background-color: var(--dora-index-list-item-background-color, var(--dora-color-step-15, #d9d9d9));
  --item-size: var(--dora-index-list-item-size, 56rpx);
  --item-padding-vertical: var(--dora-index-list-item-padding-vertical, 0);
  --item-padding-horizontal: var(--dora-index-list-item-padding-horizontal, 32rpx);
}

.dora-index-list-item__hd {
  background: #d9d9d9;
  background: var(--item-background-color);
  width: 100%;
  height: 56rpx;
  height: var(--item-size);
  line-height: 56rpx;
  line-height: var(--item-size);
  padding: 0 32rpx;
  padding: var(--item-padding-vertical) var(--item-padding-horizontal);
  box-sizing: border-box;
}