@import '../../@doraemon-ui/style/index.wxss';
.dora-e-sign {
  padding: 24rpx;
  padding: var(--dora-e-sign-padding, 24rpx);
}

.dora-e-sign__bd {
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx dotted #e6e6e6;
  border: 2rpx dotted var(--dora-e-sign-border-color, var(--dora-border-color, var(--dora-color-step-10, #e6e6e6)));
  border-radius: 16rpx;
  border-radius: var(--dora-e-sign-bd-border-radius, var(--dora-border-radius, 16rpx));
  overflow: hidden;
}

.dora-e-sign__ft {
  display: flex;
  justify-content: flex-end;
}

.dora-e-sign__button {
  padding-left: 24rpx!important;
  padding-left: var(--dora-e-sign-button-padding, 24rpx)!important;
  padding-right: 24rpx!important;
  padding-right: var(--dora-e-sign-button-padding, 24rpx)!important;
  margin-top: 18rpx!important;
  margin-top: var(--dora-e-sign-button-margin, 18rpx)!important;
  margin-left: 18rpx!important;
  margin-left: var(--dora-e-sign-button-margin, 18rpx)!important;
}