@import '../../@doraemon-ui/style/index.wxss';
.dora-keyboard {
  display: block;
  width: 100%;
  color: rgba(0,0,0,0.65);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.65);
  background-color: #f7f7f7;
}

.dora-keyboard__hd {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #1f2324;
  font-size: 30rpx;
  position: relative;
}

.dora-keyboard__hd::after {
  content: " ";
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  height: 2rpx;
  border-bottom: 2rpx solid #d9d9d9;
  border-bottom: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 100%;
  transform: scaleY(0.5);
}

.dora-keyboard__bd {
  margin: 30rpx 80rpx;
  display: flex;
  position: relative;
  background-color: #f7f7f7;
  background-color: var(--dora-keyboard-bg, #f7f7f7);
}

.dora-keyboard__input {
  width: 100%;
  padding: 8rpx;
  height: 80rpx;
  height: var(--dora-keyboard-input-size, 80rpx);
  min-height: 80rpx;
  min-height: var(--dora-keyboard-input-size, 80rpx);
  text-align: center;
  box-sizing: border-box;
}

.dora-keyboard__label {
  flex: 1;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100rpx;
}

.dora-keyboard__label:not(:last-child)::after {
  content: "";
  width: 1px;
  height: 50%;
  position: absolute;
  right: 0;
  top: 25%;
  background-color: #d9d9d9;
  background-color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform: scaleX(0.5);
}

.dora-keyboard__password {
  width: auto;
  height: auto;
  display: none;
}

.dora-keyboard__password--dot {
  width: 8px;
  width: var(--dora-keyboard-dot-size, 8px);
  height: 8px;
  height: var(--dora-keyboard-dot-size, 8px);
  border-radius: 50%;
  background-color: #333;
  background-color: var(--dora-keyboard-dot-bg, #333);
}

.dora-keyboard__password--active {
  display: block;
}

.dora-keyboard__ft {
  background-color: #f7f7f7;
  background-color: var(--dora-keyboard-bg, #f7f7f7);
  position: relative;
}

.dora-keyboard__ft::before {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 1px;
  border-top: 1px solid #d9d9d9;
  border-top: 1px solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 0;
  transform: scaleY(0.5);
}

.dora-keyboard__title {
  overflow: hidden;
  padding: 10px 0 6px;
  color: #222;
  margin-bottom: 1px;
  font-size: 12px;
  text-align: center;
  background-color: #f7f7f7;
  background-color: var(--dora-keyboard-bg, #f7f7f7);
}

.dora-keyboard__numbers {
  font-size: 24px;
  background-color: #f7f7f7;
  background-color: var(--dora-keyboard-bg, #f7f7f7);
}

.dora-keyboard__number {
  display: flex;
  width: 100%;
}

.dora-keyboard__text {
  display: flex;
  width: 1%;
  flex: 1;
  color: #222;
  height: 50px;
  position: relative;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.dora-keyboard__text::before {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 1px;
  border-top: 1px solid #d9d9d9;
  border-top: 1px solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 0 0;
  transform: scaleY(0.5);
}

.dora-keyboard__text:not(:last-child)::after {
  content: " ";
  position: absolute;
  right: 0;
  top: 0;
  width: 2rpx;
  bottom: 0;
  border-right: 2rpx solid #d9d9d9;
  border-right: 2rpx solid var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  color: #d9d9d9;
  color: var(--dora-border-color-split, var(--dora-color-step-15, #d9d9d9));
  transform-origin: 100%0;
  transform: scaleX(0.5);
}

.dora-keyboard__text--hover {
  background-color: #dedede;
  color: rgba(0,0,0,0.6);
}

.dora-keyboard__number:last-child .dora-keyboard__text:last-child,.dora-keyboard__number:last-child .dora-keyboard__text:nth-last-child(3) {
  background-color: #f7f7f7;
  font-size: 30rpx;
  color: #686868;
}