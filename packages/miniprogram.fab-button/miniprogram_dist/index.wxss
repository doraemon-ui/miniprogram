@import '../../@doraemon-ui/style/index.wxss';
.dora-fab-button {
  --background-color: var(--dora-color-positive, #3880ff);
  position: fixed;
  z-index: 1000;
  cursor: pointer;
}

.dora-fab-button--center {
  left: 50%;
  top: 50%;
  transform: translate3d(-50%,-50%,0);
}

.dora-fab-button--topLeft {
  left: 30rpx;
  top: 30rpx;
}

.dora-fab-button--topRight {
  right: 30rpx;
  top: 30rpx;
}

.dora-fab-button--bottomLeft {
  left: 30rpx;
  bottom: 30rpx;
}

.dora-fab-button--bottomRight {
  right: 30rpx;
  bottom: 30rpx;
}

.dora-fab-button--vertical.dora-fab-button--topLeft .dora-fab-button__label,.dora-fab-button--vertical.dora-fab-button--bottomLeft .dora-fab-button__label {
  left: 120rpx;
}

.dora-fab-button--vertical.dora-fab-button--center .dora-fab-button__label,.dora-fab-button--vertical.dora-fab-button--topRight .dora-fab-button__label,.dora-fab-button--vertical.dora-fab-button--bottomRight .dora-fab-button__label {
  right: 120rpx;
}

.dora-fab-button__action {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  border-radius: 50%;
  z-index: 1000;
  background-color: #3880ff;
  background-color: var(--background-color);
  color: #fff;
  overflow: visible;
  transition-duration: 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 8rpx rgba(0,0,0,0.14),0 8rpx 16rpx rgba(0,0,0,0.28);
  right: 0;
  bottom: 0;
}

.dora-fab-button--hover {
  transition-duration: 0s;
  opacity: 0.8!important;
}

.dora-fab-button__action--hide-shadow {
  box-shadow: none!important;
}

.dora-fab-button__icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  font-size: 40rpx;
  line-height: 1;
}

.dora-fab-button__text {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  font-size: 40rpx;
  line-height: 1;
  transition: transform 150ms cubic-bezier(0.4,0,1,1);
}

.dora-fab-button__text--rotate {
  transform: scale(1) rotate(135deg);
}

.dora-fab-button__button {
  border: 0;
  border-radius: 50%;
  overflow: visible;
  color: #fff!important;
  background-color: #3880ff!important;
  background-color: var(--background-color)!important;
  transition-duration: 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 8rpx rgba(0,0,0,0.14),0 8rpx 16rpx rgba(0,0,0,0.28);
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
  z-index: 2;
  width: 100%!important;
  height: 100%;
  padding: 0;
}

.dora-fab-button__button--hover {
  transition-duration: 0s;
  opacity: 0.8!important;
}

.dora-fab-button__button--disabled {
  opacity: 0.3!important;
  opacity: var(--dora-disabled-opacity, 0.3)!important;
  cursor: not-allowed!important;
}

.dora-fab-button__button--hide-shadow {
  box-shadow: none!important;
}

.dora-fab-button__label {
  position: absolute;
  top: 50%;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  background: rgba(0,0,0,0.4);
  background: rgba(var(--dora-black-rgb, 0, 0, 0),0.4);
  border-radius: 8rpx;
  color: rgba(255,255,255,0.85);
  color: rgba(var(--dora-white-rgb, 255, 255, 255),0.85);
  pointer-events: none;
  white-space: nowrap;
  opacity: 0;
  box-sizing: border-box;
  transform: translate3d(0,-50%,0);
  transition: all 0.3s;
}

.dora-fab-button--vertical.dora-fab-button--opened .dora-fab-button__label {
  opacity: 1;
}

.dora-fab-button__backdrop {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  left: 0;
  bottom: 0;
  background: transparent;
}

.dora-fab-button.dora-color {
  --background-color: var(--dora-color-base);
}