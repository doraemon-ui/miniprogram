@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-alert {
  padding: var(--dora-alert-padding-vertical, 12px) var(--dora-alert-padding-horizontal, 16px);
  padding: var(--dora-alert-padding-vertical, 12px) var(--dora-alert-padding-horizontal, 16px);
  position: relative;
  display: flex;
  align-items: center;
  border-radius: var(--dora-alert-border-radius, var(--dora-border-radius-sm, 4px));
  border-radius: var(--dora-alert-border-radius, var(--dora-border-radius-sm, 4px));
  font-size: var(--dora-alert-font-size, 14px);
  font-size: var(--dora-alert-font-size, 14px);
  color: var(--dora-white, #fff);
  color: var(--dora-white, #fff);
  background-color: var(--background-color);
  background-color: var(--background-color);
  --background-color: var(--dora-color-positive, #3880ff);
}

.dora-alert__thumb {
  width: var(--dora-alert-thumb-size, 20px);
  width: var(--dora-alert-thumb-size, 20px);
  height: var(--dora-alert-thumb-size, 20px);
  height: var(--dora-alert-thumb-size, 20px);
  display: block;
  margin-right: var(--dora-alert-thumb-margin, 6px);
  margin-right: var(--dora-alert-thumb-margin, 6px);
}

.dora-alert__bd {
  flex: 1;
}

.dora-alert__text {
  text-align: left;
}

.dora-alert__desc {
  text-align: left;
  line-height: 1.2;
  font-size: 12px;
}

.dora-alert__ft {
  display: flex;
  align-self: center;
  text-align: right;
}

.dora-alert__closable:not(:empty) {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: var(--dora-alert-closable-margin-left, 6px);
  margin-left: var(--dora-alert-closable-margin-left, 6px);
  cursor: pointer;
}

.dora-alert.dora-color {
  --background-color: var(--dora-color-base);
}