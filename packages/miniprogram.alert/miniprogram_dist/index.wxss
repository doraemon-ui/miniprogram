@import '../../@doraemon-ui/style/index.wxss';
.dora-alert {
  padding: 24rpx 32rpx;
  padding: var(--dora-alert-padding-vertical, 24rpx) var(--dora-alert-padding-horizontal, 32rpx);
  position: relative;
  display: flex;
  align-items: center;
  border-radius: 8rpx;
  border-radius: var(--dora-alert-border-radius, var(--dora-border-radius-sm, 8rpx));
  font-size: 28rpx;
  font-size: var(--dora-alert-font-size, 28rpx);
  color: #fff;
  color: var(--dora-white, #fff);
  background-color: #3880ff;
  background-color: var(--background-color);
  --background-color: var(--dora-color-positive, #3880ff);
}

.dora-alert__thumb {
  width: 40rpx;
  width: var(--dora-alert-thumb-size, 40rpx);
  height: 40rpx;
  height: var(--dora-alert-thumb-size, 40rpx);
  display: block;
  margin-right: 12rpx;
  margin-right: var(--dora-alert-thumb-margin, 12rpx);
}

.dora-alert__bd {
  flex: 1;
}

.dora-alert__text {
  text-align: left;
}

.dora-alert__desc {
  text-align: left;
  line-height: 1.2;
  font-size: 24rpx;
}

.dora-alert__ft {
  display: flex;
  align-self: center;
  text-align: right;
}

.dora-alert__closable:not(:empty) {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 12rpx;
  margin-left: var(--dora-alert-closable-margin-left, 12rpx);
  cursor: pointer;
}

.dora-alert.dora-color {
  --background-color: var(--dora-color-base);
}