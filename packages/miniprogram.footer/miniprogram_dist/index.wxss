@import '../../@doraemon-ui/style/index.wxss';
.dora-footer {
  --link-color: var(--dora-color-positive, #3880ff);
  --chip-link-background-color: rgba(56, 128, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fff;
  background-color: var(--dora-component-background-color, #fff);
  color: rgba(0,0,0,0.65);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.65);
  font-size: 26rpx;
}

.dora-footer__label {
  width: 100%;
}

.dora-footer__links {
  margin: 18rpx 0;
  color: #3880ff;
  color: var(--link-color);
  white-space: nowrap;
}

.dora-footer__link {
  display: inline-block;
  text-decoration: none;
  cursor: pointer;
}

.dora-footer__content {
  display: flex;
  align-items: center;
  margin: 18rpx 0;
  color: rgba(0,0,0,0.45);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.45);
}

.dora-footer__chips {
  display: flex;
  align-items: center;
  white-space: nowrap;
  margin: 18rpx 0;
}

.dora-footer__chip {
  white-space: nowrap;
  margin-right: 32rpx;
  font-size: 24rpx;
  background-color: #e6e6e6;
  background-color: var(--dora-color-step-10, #e6e6e6);
  color: rgba(0,0,0,0.45);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.45);
  padding: 10rpx 22rpx;
  border-radius: 200rpx;
}

.dora-footer__chip:last-child {
  margin-right: 0;
}

.dora-footer__chip--link {
  cursor: pointer;
  color: #3880ff;
  color: var(--link-color);
  background-color: rgba(56,128,255,0.12);
  background-color: var(--chip-link-background-color);
}

.dora-footer.dora-color {
  --link-color: var(--dora-color-base);
  --chip-link-background-color: var(--dora-color-step-10, #e6e6e6);
}