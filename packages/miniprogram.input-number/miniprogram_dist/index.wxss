@import '../../@doraemon-ui/style/index.wxss';
.dora-input-number {
  position: relative;
  display: flex;
  --text-color: var(--dora-color-positive, #3880ff);
  --border-color: var(--dora-color-positive, #3880ff);
}

.dora-input-number__control {
  width: 96rpx;
  height: 52rpx;
  border: 2rpx solid #e6e6e6;
  border: 2rpx solid var(--dora-border-color, var(--dora-color-step-10, #e6e6e6));
  padding: 6rpx 0;
  box-sizing: border-box;
}

.dora-input-number__input {
  width: 100%;
  height: 100%;
  min-height: inherit;
  border: 0;
  font-size: 32rpx;
  line-height: 1;
  color: rgba(0,0,0,0.65);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.65);
  text-align: center;
  background: transparent;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  box-sizing: border-box;
}

.dora-input-number__input--disabled {
  opacity: 1;
}

.dora-input-number__selector {
  width: 68rpx;
  height: 52rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #3880ff;
  color: var(--text-color);
  border: 2rpx solid #e6e6e6;
  border: 2rpx solid var(--dora-border-color, var(--dora-color-step-10, #e6e6e6));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dora-input-number__selector--disabled {
  --text-color: var(--dora-input-number-disabled-color, var(--dora-color-step-20, #cccccc));
  --border-color: var(--dora-input-number-disabled-color, var(--dora-color-step-20, #cccccc));
}

.dora-input-number__selector--sub {
  border-right: none;
  padding: 6rpx 20rpx;
  border-radius: 8rpx0 0 8rpx;
  border-radius: var(--dora-border-radius-sm, 8rpx)0 0 var(--dora-border-radius-sm, 8rpx);
}

.dora-input-number__selector--add {
  border-left: none;
  padding: 6rpx 16rpx;
  border-radius: 0 8rpx 8rpx0;
  border-radius: 0 var(--dora-border-radius-sm, 8rpx) var(--dora-border-radius-sm, 8rpx)0;
}

.dora-input-number__icon {
  font-size: inherit!important;
  vertical-align: middle;
  line-height: inherit;
}

.dora-input-number--circle .dora-input-number__control {
  border-color: transparent;
}

.dora-input-number--circle .dora-input-number__selector {
  width: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #3880ff;
  border: 2rpx solid var(--border-color);
}

.dora-input-number.dora-color {
  --text-color: var(--dora-color-base);
  --border-color: var(--dora-color-base);
}