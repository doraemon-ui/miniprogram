@import '../../@doraemon-ui/style/index.wxss';
.dora-input-number {
  position: relative;
  display: flex;
}

.dora-input-number__control {
  width: 96rpx;
  height: 52rpx;
  border: 2rpx solid #e6e6e6;
  border: 2rpx solid var(--dora-border-color, var(--dora-color-step-10, #e6e6e6));
  padding: 6rpx 0;
  box-sizing: border-box;
}

.dora-input-number__input {
  width: 100%;
  height: 100%;
  min-height: inherit;
  border: 0;
  font-size: 32rpx;
  line-height: 1;
  color: rgba(0,0,0,0.65);
  color: rgba(var(--dora-text-color-rgb, 0, 0, 0),0.65);
  text-align: center;
  background: transparent;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  box-sizing: border-box;
}

.dora-input-number__input--disabled {
  opacity: 1;
}

.dora-input-number__selector {
  width: 68rpx;
  height: 52rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #2dd36f;
  color: var(--dora-input-number-balanced-color, var(--dora-color-balanced, #2dd36f));
  border: 2rpx solid #e6e6e6;
  border: 2rpx solid var(--dora-border-color, var(--dora-color-step-10, #e6e6e6));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dora-input-number__selector--disabled {
  color: #c7c7cc!important;
  color: var(--dora-input-number-disabled-color, #c7c7cc)!important;
  cursor: not-allowed;
}

.dora-input-number__selector--sub {
  border-right: none;
  padding: 6rpx 20rpx;
  border-radius: 8rpx0 0 8rpx;
  border-radius: var(--dora-border-radius-sm, 8rpx)0 0 var(--dora-border-radius-sm, 8rpx);
}

.dora-input-number__selector--add {
  border-left: none;
  padding: 6rpx 16rpx;
  border-radius: 0 8rpx 8rpx0;
  border-radius: 0 var(--dora-border-radius-sm, 8rpx) var(--dora-border-radius-sm, 8rpx)0;
}

.dora-input-number__icon {
  font-size: inherit!important;
  vertical-align: middle;
  line-height: inherit;
}

.dora-input-number--circle .dora-input-number__control {
  border-color: transparent;
}

.dora-input-number--circle .dora-input-number__selector {
  width: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #2dd36f;
  border: 2rpx solid var(--dora-input-number-balanced-color, var(--dora-color-balanced, #2dd36f));
}

.dora-input-number--circle .dora-input-number__selector--disabled {
  border-color: #c7c7cc!important;
  border-color: var(--dora-input-number-disabled-color, #c7c7cc)!important;
}

.dora-input-number .dora-input-number__selector--light {
  color: #f4f5f8;
  color: var(--dora-input-number-light-color, var(--dora-color-light, #f4f5f8));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--light {
  border-color: #f4f5f8;
  border-color: var(--dora-input-number-light-color, var(--dora-color-light, #f4f5f8));
}

.dora-input-number .dora-input-number__selector--stable {
  color: #636469;
  color: var(--dora-input-number-stable-color, var(--dora-color-stable, #636469));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--stable {
  border-color: #636469;
  border-color: var(--dora-input-number-stable-color, var(--dora-color-stable, #636469));
}

.dora-input-number .dora-input-number__selector--positive {
  color: #3880ff;
  color: var(--dora-input-number-positive-color, var(--dora-color-positive, #3880ff));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--positive {
  border-color: #3880ff;
  border-color: var(--dora-input-number-positive-color, var(--dora-color-positive, #3880ff));
}

.dora-input-number .dora-input-number__selector--calm {
  color: #3dc2ff;
  color: var(--dora-input-number-calm-color, var(--dora-color-calm, #3dc2ff));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--calm {
  border-color: #3dc2ff;
  border-color: var(--dora-input-number-calm-color, var(--dora-color-calm, #3dc2ff));
}

.dora-input-number .dora-input-number__selector--assertive {
  color: #eb445a;
  color: var(--dora-input-number-assertive-color, var(--dora-color-assertive, #eb445a));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--assertive {
  border-color: #eb445a;
  border-color: var(--dora-input-number-assertive-color, var(--dora-color-assertive, #eb445a));
}

.dora-input-number .dora-input-number__selector--balanced {
  color: #2dd36f;
  color: var(--dora-input-number-balanced-color, var(--dora-color-balanced, #2dd36f));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--balanced {
  border-color: #2dd36f;
  border-color: var(--dora-input-number-balanced-color, var(--dora-color-balanced, #2dd36f));
}

.dora-input-number .dora-input-number__selector--energized {
  color: #ffc409;
  color: var(--dora-input-number-energized-color, var(--dora-color-energized, #ffc409));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--energized {
  border-color: #ffc409;
  border-color: var(--dora-input-number-energized-color, var(--dora-color-energized, #ffc409));
}

.dora-input-number .dora-input-number__selector--royal {
  color: #8a63d2;
  color: var(--dora-input-number-royal-color, var(--dora-color-royal, #8a63d2));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--royal {
  border-color: #8a63d2;
  border-color: var(--dora-input-number-royal-color, var(--dora-color-royal, #8a63d2));
}

.dora-input-number .dora-input-number__selector--dark {
  color: #222428;
  color: var(--dora-input-number-dark-color, var(--dora-color-dark, #222428));
}

.dora-input-number .dora-input-number--circle .dora-input-number__selector--dark {
  border-color: #222428;
  border-color: var(--dora-input-number-dark-color, var(--dora-color-dark, #222428));
}