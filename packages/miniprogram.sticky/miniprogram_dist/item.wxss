@import '../../@doraemon-ui/style/var.wxss';
@import '../../@doraemon-ui/style/color.wxss';
.dora-sticky-item {
  --title-background-color: var(--dora-sticky-title-background-color, var(--dora-color-step-10, #e6e6e6));
  --title-height: var(--dora-sticky-title-height, 44px);
  --title-padding: var(--dora-sticky-title-padding, 0 16px);
  --font-size: var(--dora-sticky-font-size, 14px);
  position: relative;
  font-size: 14px;
  font-size: var(--font-size);
}

.dora-sticky-item__hd {
  width: 100%;
  height: 44px;
  height: var(--title-height);
  background: #e6e6e6;
  background: var(--title-background-color);
  line-height: 44px;
  line-height: var(--title-height);
}

.dora-sticky-item__title {
  box-sizing: border-box;
  width: 100%;
  padding: 0 16px;
  padding: var(--title-padding);
  background: #e6e6e6;
  background: var(--title-background-color);
}

.dora-sticky-item--fixed .dora-sticky-item__title {
  position: fixed;
  top: 0;
  left: 0;
  z-index: calc(1 + 1);
  z-index: calc(var(--dora-sticky-z-index, 1) + 1);
}