/* pages/index/index.wxss */
.logo {
  display: flex;
  flex-direction: column;
  padding: 60rpx;
  margin-bottom: 30rpx;
}

.logo__bd {
  display: flex;
  padding-bottom: 30rpx;
}

.logo__img {
  display: block;
  width: 72rpx;
  height: 72rpx;
  margin-right: 12rpx;
}

.logo__text {
  padding-right: 12rpx;
  font-size: 48rpx;
  font-style: italic;
  font-weight: bold;
  line-height: 1.5;
  text-align: left;
  background: linear-gradient(left, #04BE02, #2d8cf0);
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.logo__ft {
  font-size: 26rpx;
  line-height: 1.5;
  color: rgb(0 0 0 / 45%);
}

.demo-category-item {
  margin: 0 32rpx 24rpx;
}

.demo-category-group__hd {
  box-sizing: border-box;
  width: 100%;
  padding: 30rpx 30rpx 18rpx;
  font-size: 28rpx;
  color: rgb(0 0 0 / 45%);
}

.demo-category-group__bd {
  position: relative;
  background-color: #fff;
}

.demo-category-group__ft {
  padding: 18rpx 30rpx 30rpx;
  font-size: 28rpx;
  color: rgb(0 0 0 / 45%);
}

.demo-category-item__hd {
  position: relative;
  box-sizing: border-box;
  display: flexbox;
  display: flex;
  align-items: center;
  width: auto;
  padding: 20rpx 30rpx;
  padding-right: 60rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 100rpx;
  color: #000;
  white-space: nowrap;
  background-color: #fff;
  border-radius: 4rpx;
  -ms-flex-align: center;
}

.demo-category-item__thumb {
  display: block;
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.demo-category-item__arrow {
  position: absolute;
  top: 55rpx;
  right: 30rpx;
  display: block;
  width: 30rpx;
  height: 30rpx;
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg width='16' height='26' viewBox='0 0 16 26' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 0L0 2l11.5 11L0 24l2 2 14-13z' fill='%23C7C7CC' fill-rule='evenodd'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: 50% 50%;
  background-size: contain;
  transform: rotate(90deg);
  transition: transform .2s ease;
}

.demo-category-item--current > .demo-category-item__hd > .demo-category-item__arrow {
  transform: rotate(270deg);
}

.demo-category-item__bd {
  position: relative;
  display: none;
  overflow: hidden;
  font-size: 30rpx;
  color: rgb(0 0 0 / 85%);
  background: #fff;
  /* padding: 30rpx */
}

.demo-category-item--current > .demo-category-item__bd {
  display: block;
}

.demo-category-cell {
  position: relative;
  box-sizing: border-box;
  display: flexbox;
  display: flex;
  align-items: center;
  width: auto !important;
  min-height: 0 !important;
    padding: 0;
  padding: 20rpx 30rpx;
  padding: 32rpx;
  margin: 0;
  overflow: visible;
  font-size: inherit;
  font-weight: 400;
  line-height: inherit;
  color: inherit !important;
  text-align: inherit;
  text-decoration: none;
  background: 0 0 !important;
  background: #fff;
  border-radius: 0;
  -webkit-tap-highlight-color: transparent;
  -ms-flex-align: center;
}

.demo-category-cell::after {
  position: static;
  top: auto;
  left: auto;
  display: block;
  width: auto;
  height: auto;
  border: none;
  border-radius: 0;
  transform: none;
  transform-origin: 0 0;
}

.demo-category-cell--has-line.demo-category-cell::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  left: 30rpx;
  height: 1PX;
  color: #d9d9d9;
  content: ' ';
  border-bottom: 1PX solid #d9d9d9;
  transform: scaleY(.5);
  transform-origin: 0 100%;
}

.demo-category-cell--last::after {
  display: none;
}

.demo-category-cell--hover {
  background-color: #ececec !important;
}

.demo-category-cell--disabled {
  opacity: .3;
}

.demo-category-cell__thumb {
  display: block;
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.demo-category-cell__bd {
  flex: 1;
  flex: 1;
}

.demo-category-cell__text {
  text-align: left;
}

.demo-category-cell__desc {
  font-size: 24rpx;
  line-height: 1.2;
  color: rgb(0 0 0 / 45%);
  text-align: left;
}

.demo-category-cell__ft {
  color: rgb(0 0 0 / 45%);
  text-align: right;
}

.demo-category-cell--access .demo-category-cell__ft {
  position: absolute;
  top: 41rpx;
  right: 30rpx;
  display: block;
  width: 30rpx;
  height: 30rpx;
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg width='16' height='26' viewBox='0 0 16 26' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 0L0 2l11.5 11L0 24l2 2 14-13z' fill='%23C7C7CC' fill-rule='evenodd'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: 50% 50%;
  background-size: contain;
  transform: rotate(90deg);
  transform: rotate(0deg);
  transition: transform .2s ease;
}
