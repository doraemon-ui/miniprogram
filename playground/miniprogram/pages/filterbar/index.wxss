.panel {
  position: relative;
  margin-top: 10px;
  overflow: hidden;
  background-color: var(--dora-background-color, #fafafa);
}

.panel:first-child {
  margin-top: 0;
}

.panel::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 1px;
  color: var(--dora-color-step-10, #e6e6e6);
  content: ' ';
  border-top: 1rpx solid var(--dora-color-step-10, #e6e6e6);
}

.panel::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  color: var(--dora-color-step-10, #e6e6e6);
  content: ' ';
  border-bottom: 1rpx solid var(--dora-color-step-10, #e6e6e6);
}

.panel__hd {
  position: relative;
  padding: 14px 15px 10px;
  font-size: 13px;
  color: #999;
}

.panel__hd::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  left: 15px;
  height: 1px;
  color: var(--dora-color-step-10, #e6e6e6);
  content: ' ';
  border-bottom: 1rpx solid var(--dora-color-step-10, #e6e6e6);
}

.media-box {
  position: relative;
  padding: 15px;
}

.media-box::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  left: 15px;
  height: 1px;
  color: var(--dora-color-step-10, #e6e6e6);
  content: ' ';
  border-top: 1rpx solid var(--dora-color-step-10, #e6e6e6);
}

.media-box:first-child::before {
  display: none;
}

.media-box__title {
  width: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 17px;
  font-weight: 400;
  word-break: break-all;
  overflow-wrap: normal;
  overflow-wrap: break-word;
  white-space: nowrap;
}

.media-box__desc {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  font-size: 13px;
  line-height: 1.2;
  color: #999;
  -webkit-box-orient: vertical;
}

.media-box__info {
  padding-bottom: 5px;
  margin-top: 15px;
  overflow: hidden;
  font-size: 13px;
  line-height: 1em;
  color: #cecece;
  list-style: none;
}

.media-box__info__meta {
  float: left;
  padding-right: 1em;
}

.media-box__info__meta_extra {
  padding-left: 1em;
  border-left: 1px solid #cecece;
}

.media-box__title_in-text {
  margin-bottom: 8px;
}

.media-box_appmsg {
  display: -webkit-box;
  display: flex;
  display: flex;
  align-items: center;
  align-items: center;
  align-items: center;
}

.media-box__thumb {
  width: 100%;
  height: 100%;
  vertical-align: top;
}

.media-box__hd_in-appmsg {
  width: 60px;
  height: 60px;
  margin-right: 0.8em;
  line-height: 60px;
  text-align: center;
}

.media-box__bd_in-appmsg {
  flex: 1;
  flex: 1;
  min-width: 0;
}

.media-box_small-appmsg {
  padding: 0;
}
