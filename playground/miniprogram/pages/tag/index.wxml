<demo-page
  darkmode="auto"
  title="Tag"
  desc="标签"
  clickable
  spacing
>
  <demo-block title="Default">
    <dora-tag>light</dora-tag>
    <dora-tag color="light">light</dora-tag>
    <dora-tag color="stable">stable</dora-tag>
    <dora-tag color="positive">positive</dora-tag>
    <dora-tag color="calm">calm</dora-tag>
    <dora-tag color="balanced">balanced</dora-tag>
    <dora-tag color="energized">energized</dora-tag>
    <dora-tag color="assertive">assertive</dora-tag>
    <dora-tag color="royal">royal</dora-tag>
    <dora-tag color="dark">dark</dora-tag>
  </demo-block>

  <demo-block title="Fill = solid">
    <dora-tag fill="solid">light</dora-tag>
    <dora-tag fill="solid" color="light">light</dora-tag>
    <dora-tag fill="solid" color="stable">stable</dora-tag>
    <dora-tag fill="solid" color="positive">positive</dora-tag>
    <dora-tag fill="solid" color="calm">calm</dora-tag>
    <dora-tag fill="solid" color="balanced">balanced</dora-tag>
    <dora-tag fill="solid" color="energized">energized</dora-tag>
    <dora-tag fill="solid" color="assertive">assertive</dora-tag>
    <dora-tag fill="solid" color="royal">royal</dora-tag>
    <dora-tag fill="solid" color="dark">dark</dora-tag>
  </demo-block>

  <demo-block title="Fill = outline">
    <dora-tag fill="outline">light</dora-tag>
    <dora-tag fill="outline" color="light">light</dora-tag>
    <dora-tag fill="outline" color="stable">stable</dora-tag>
    <dora-tag fill="outline" color="positive">positive</dora-tag>
    <dora-tag fill="outline" color="calm">calm</dora-tag>
    <dora-tag fill="outline" color="balanced">balanced</dora-tag>
    <dora-tag fill="outline" color="energized">energized</dora-tag>
    <dora-tag fill="outline" color="assertive">assertive</dora-tag>
    <dora-tag fill="outline" color="royal">royal</dora-tag>
    <dora-tag fill="outline" color="dark">dark</dora-tag>
  </demo-block>

  <demo-block title="Custom color">
    <dora-tag color="#f50">#f50</dora-tag>
    <dora-tag fill="fill" color="#2db7f5">#2db7f5</dora-tag>
    <dora-tag fill="solid" color="#87d068">#87d068</dora-tag>
    <dora-tag fill="outline" color="#108ee9">#108ee9</dora-tag>
  </demo-block>

  <demo-block title="Closable">
    <dora-tag closable bind:close="onClose">Tag 1</dora-tag>
    <dora-tag closable visible="{{ visible }}" controlled bind:close="onClose" bind:change="onChange">Tag 3</dora-tag>
    <dora-tag bind:click="onToggle">Toggle</dora-tag>
  </demo-block>
</demo-page>