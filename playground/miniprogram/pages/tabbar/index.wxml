<demo-page title="TabBar" desc="标签栏" clickable>
  <demo-block padding="0" title="Default">
    <dora-tabbar defaultCurrent="tab2">
      <dora-tabbar-item key="tab1" title="Tab 1">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
      <dora-tabbar-item key="tab2" title="Tab 2">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
      <dora-tabbar-item key="tab3" title="Tab 3">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
    </dora-tabbar>
  </demo-block>
  <demo-block padding="0" title="Color = balanced">
    <dora-tabbar defaultCurrent="1" color="balanced">
      <dora-tabbar-item title="Tab 1">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
      <dora-tabbar-item title="Tab 2">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
      <dora-tabbar-item title="Tab 3">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
    </dora-tabbar>
  </demo-block>
  <demo-block padding="0" title="Disabled">
    <dora-tabbar defaultCurrent="1">
      <dora-tabbar-item title="Tab 1">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
      <dora-tabbar-item title="Tab 2" disabled>
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
      <dora-tabbar-item title="Tab 3">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
    </dora-tabbar>
  </demo-block>
  <demo-block padding="0" title="Controlled">
    <dora-tabbar controlled current="{{ current }}" bindchange="onChange">
      <dora-tabbar-item title="Tab 1">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
      <dora-tabbar-item title="Tab 2">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
      <dora-tabbar-item title="Tab 3">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
    </dora-tabbar>
  </demo-block>
  <demo-block padding="0" title="With Badge">
    <dora-tabbar defaultCurrent="1" position="bottom" safeArea backgroundColor="#000">
      <dora-tabbar-item title="Tab 1">
        <dora-badge dora-class-badge="tabbar-icon-badge" count="1" slot="icon-on">
          <dora-icon dora-class="icon" type="heart" size="22" />
        </dora-badge>
        <dora-badge dora-class-badge="tabbar-icon-badge" count="1" slot="icon-off">
          <dora-icon dora-class="icon" type="heart" size="22" />
        </dora-badge>
      </dora-tabbar-item>
      <dora-tabbar-item title="Tab 2">
        <dora-badge dora-class-badge="tabbar-icon-badge" dot slot="icon-on">
          <dora-icon dora-class="icon" type="heart" size="22" />
        </dora-badge>
        <dora-badge dora-class-badge="tabbar-icon-badge" dot slot="icon-off">
          <dora-icon dora-class="icon" type="heart" size="22" />
        </dora-badge>
      </dora-tabbar-item>
      <dora-tabbar-item title="Tab 3">
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-on" />
        <dora-icon dora-class="icon" type="heart" size="22" slot="icon-off" />
      </dora-tabbar-item>
    </dora-tabbar>
  </demo-block>
</demo-page>