.bordered::before {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 2rpx;
  color: #d9d9d9;
  content: ' ';
  border-bottom: 2rpx solid #d9d9d9;
  transform: scaleY(0.5);
  transform-origin: 0 100%;
}

.content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 150px;
  background-color: #fff;
}
