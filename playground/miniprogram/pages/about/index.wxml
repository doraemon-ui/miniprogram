<view class="container">
	<view class="userinfo" data-clipboard="{{ userInfo.url }}" bindtap="clipboard">
		<image class="userinfo-avatar" src="{{ userInfo.avatarUrl }}" background-size="cover"></image>
		<text class="userinfo-nickname">{{ userInfo.nickname }}</text>
    <view class="userinfo-desc">{{ userInfo.desc }}</view>
	</view>
</view>
<dora-grids dora-class="grid-box">
  <dora-grid>
    <view class="grid-title">30K</view>
    <view class="grid-desc">
      <dora-icon dora-class="grid-icon" type="ios-eye" size="18" />
      <view>Views</view>
    </view>
  </dora-grid>
  <dora-grid>
    <view class="grid-title">4k</view>
    <view class="grid-desc">
      <dora-icon dora-class="grid-icon" type="ios-star" size="18" />
      <view>Stars</view>
    </view>
  </dora-grid>
  <dora-grid>
    <view class="grid-title">800</view>
    <view class="grid-desc">
      <dora-icon dora-class="grid-icon" type="ios-git-branch" size="18" />
      <view>Forks</view>
    </view>
  </dora-grid>
</dora-grids>
<dora-list>
  <dora-list-item title="Github" is-link data-clipboard="https://github.com/skyvow" bind:click="clipboard">
    <dora-icon dora-class="icon" slot="header" type="logo-github" size="22" />
  </dora-list-item>
  <dora-list-item title="Sponsor" is-link data-url="http://cdn.skyvow.cn/wxpay.jpg" bind:click="onPreview">
    <dora-icon dora-class="icon" slot="header" type="ios-thumbs-up" size="22" />
  </dora-list-item>
  <dora-list-item title="Share" is-link open-type="share">
    <dora-icon dora-class="icon" slot="header" type="ios-share-alt" size="22" />
  </dora-list-item>
</dora-list>
