.container {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 60rpx 0;
    text-align: center;
}

.userinfo {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.userinfo-avatar {
    width: 128rpx;
    height: 128rpx;
    margin: 20rpx;
    border-radius: 50%;
}

.userinfo-nickname {
    color: rgb(0 0 0 / 85%);
}

.userinfo-desc {
    color: rgb(0 0 0 / 45%);
}

.grid-box {
    margin-bottom: 60rpx;
}

.grid-title {
    margin-bottom: 20rpx;
    font-size: 48rpx;
    font-weight: 500;
    color: rgb(0 0 0 / 85%);
}

.grid-desc {
    display: flex;
    align-items: center;
    font-size: 28rpx;
    line-height: 1;
    color: rgb(0 0 0 / 45%);
}

.grid-icon {
    width: 36rpx;
    margin-right: 10rpx;
}

.icon {
    width: 44rpx;
    margin-right: 10rpx;
}
