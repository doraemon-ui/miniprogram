<demo-page darkmode="auto" title="InputNumber" desc="数字输入框" clickable>
  <dora-list title="默认">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number default-value="1024" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="主题色">
    <dora-list-item title="Light" hover-class="none">
      <dora-input-number color="light" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Stable" hover-class="none">
      <dora-input-number color="stable" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Positive" hover-class="none">
      <dora-input-number color="positive" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Calm" hover-class="none">
      <dora-input-number color="calm" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Balanced" hover-class="none">
      <dora-input-number color="balanced" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Energized" hover-class="none">
      <dora-input-number color="energized" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Assertive" hover-class="none">
      <dora-input-number color="assertive" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Royal" hover-class="none">
      <dora-input-number color="royal" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Dark" hover-class="none">
      <dora-input-number color="dark" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="圆形按钮">
    <dora-list-item title="Light" hover-class="none">
      <dora-input-number shape="circle" color="light" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Stable" hover-class="none">
      <dora-input-number shape="circle" color="stable" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Positive" hover-class="none">
      <dora-input-number shape="circle" color="positive" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Calm" hover-class="none">
      <dora-input-number shape="circle" color="calm" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Balanced" hover-class="none">
      <dora-input-number shape="circle" color="balanced" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Energized" hover-class="none">
      <dora-input-number shape="circle" color="energized" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Assertive" hover-class="none">
      <dora-input-number shape="circle" color="assertive" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Royal" hover-class="none">
      <dora-input-number shape="circle" color="royal" slot="footer" />
    </dora-list-item>
    <dora-list-item title="Dark" hover-class="none">
      <dora-input-number shape="circle" color="dark" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="监听 onChange 事件，在调试窗口中输出">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number disabled="{{ false }}" value="{{ value }}" controlled min="{{ -10 }}" max="{{ 10 }}" bind:change="onChange" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="格式化到整数">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number digits="{{ 0 }}" disabled="{{ false }}" default-value="1" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="格式化到一位小数">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number digits="{{ 1 }}" disabled="{{ false }}" default-value="1.1" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="自定义样式">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number dora-sub-class="sub" dora-control-class="control" dora-input-class="input" dora-add-class="add" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="设置步长为0.5">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number step="{{ .5 }}" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="设置值为1，最小值为-5，最大值为8">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number default-value="1" min="{{ -5 }}" max="{{ 8 }}" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="设置可输入">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number disabled="{{ false }}" slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="设置长按快速加减">
    <dora-list-item title="数量" hover-class="none">
      <dora-input-number longpress slot="footer" />
    </dora-list-item>
  </dora-list>
  <dora-list title="循环输出多个组件">
    <block wx:for="{{ items }}" wx:key="index">
      <dora-list-item title="{{ item.text }}" hover-class="none">
        <dora-input-number default-value="{{ item.value }}" slot="footer" />
      </dora-list-item>
    </block>
  </dora-list>
</demo-page>