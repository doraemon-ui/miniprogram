<demo-page title="SegmentedControl" desc="分段器" clickable>
  <demo-block title="Default">
    <dora-segmented-control values="{{ ['Segment1', 'Segment2'] }}" />
  </demo-block>

  <demo-block title="Color">
    <dora-segmented-control color="light" values="{{ ['Segment1', 'Segment2'] }}" />
    <dora-segmented-control color="stable" values="{{ ['Segment1', 'Segment2'] }}" />
    <dora-segmented-control color="positive" values="{{ ['Segment1', 'Segment2'] }}" />
    <dora-segmented-control color="calm" values="{{ ['Segment1', 'Segment2'] }}" />
    <dora-segmented-control color="balanced" values="{{ ['Segment1', 'Segment2'] }}" />
    <dora-segmented-control color="energized" values="{{ ['Segment1', 'Segment2'] }}" />
    <dora-segmented-control color="assertive" values="{{ ['Segment1', 'Segment2'] }}" />
    <dora-segmented-control color="royal" values="{{ ['Segment1', 'Segment2'] }}" />
    <dora-segmented-control color="dark" values="{{ ['Segment1', 'Segment2'] }}" />
  </demo-block>

  <demo-block title="Disabled">
    <dora-segmented-control disabled values="{{ ['Segment1', 'Segment2'] }}" />
  </demo-block>

  <demo-block title="DefaultCurrent">
    <dora-segmented-control defaultCurrent="{{ 2 }}" values="{{ ['Segment1', 'Segment2', 'Segment3'] }}" />
  </demo-block>

  <demo-block title="Controlled">
    <dora-segmented-control current="{{ current }}" controlled values="{{ ['Segment1', 'Segment2', 'Segment3'] }}" bind:change="onChange" />
  </demo-block>
</demo-page>